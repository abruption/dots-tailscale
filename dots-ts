def runtime_worker(directory, runtime, transaction):
    runtime_platform();apply_private(directory);apply_private(transaction);apply_private(transaction.parent)
    identifier=runtime_identifier(transaction.name)
    if transaction.parent!=directory/RUNTIME_DIRECTORY:raise RuntimeUpdateError('invalid_transaction')
    journal=parse_release_json(bounded_code_read(transaction,'journal.json',65536))
    if journal.get('boot_id')!=apply_boot() or journal.get('state')!='prepared' or journal.get('transaction_id')!=identifier:raise RuntimeUpdateError('invalid_transaction')
    supervisor=apply_private(transaction/'supervisor')
    if pathlib.Path(__file__).resolve()!=supervisor/'dots-ts':raise RuntimeUpdateError('invalid_transaction')
    for name in ('dots-ts','dots_proxy.py'):
        if hashlib.sha256(bounded_code_read(supervisor,name,8*1024*1024)).hexdigest()!=journal.get('worker_hashes',{}).get(name):
            raise RuntimeUpdateError('source_changed')
    import dots_proxy as proxy
    if pathlib.Path(proxy.__file__).resolve()!=supervisor/'dots_proxy.py':raise RuntimeUpdateError('source_changed')
    deadline=time.monotonic()+30
    while not (transaction/'ack').exists():
        if time.monotonic()>=deadline:
            apply_journal(transaction,journal,state='rejected',error='worker_not_acknowledged');return 1
        time.sleep(.05)
    if bounded_code_read(transaction,'ack',8)!=b'1\n':raise RuntimeUpdateError('invalid_transaction')
    commit_outcome={}
    try:
        with proxy._operation(directory):
            apply_journal(transaction,journal,worker=apply_identity(os.getpid()),phase='baseline')
            runtime_transaction(directory,runtime,transaction,journal,proxy,commit_outcome)
    except BaseException as error:
        if commit_outcome.get('state') in ('applied','failed_rolled_back'):
            # This proof is set only after the terminal journal write returned.
            # Lock/log cleanup failure cannot turn a committed update into rejection.
            try:
                apply_journal_best_effort(transaction,journal,state=commit_outcome['state'],
                    phase='cleanup_review',cleanup_warning=journal.get('cleanup_warning') or 'worker_cleanup_failed')
            except BaseException:pass
            return 0
        fenced=(directory/RUNTIME_FENCE).exists() or (directory/RUNTIME_FENCE).is_symlink()
        manual=False
        if fenced:
            try:manual=runtime_marker(directory)['transaction_id']==identifier
            except Exception:manual=True
        # A different valid fence can reject this untouched worker at lock entry.
        if journal.get('phase') in ('stop_daemon','replace_tailscale','replace_tailscaled','candidate_exec_intent','candidate_readiness','rollback_restore','rollback_readiness','manual_recovery'):
            manual=True
        apply_journal_best_effort(transaction,journal,state='manual_recovery_required' if manual else 'rejected',
            error=runtime_error(error)['error'])
    return 0


def runtime_apply(directory, runtime, version, bundle=None, confirm=False, proxy_url=None):
    import uuid
    import dots_proxy as proxy
    runtime_platform();runtime_version(version)
    if not confirm:raise RuntimeUpdateError('confirmation_required')
    directory=apply_private(directory);runtime=apply_private(runtime)
    caller=pathlib.Path(__file__).resolve().parent
    layout='source' if (caller/'tailscale-setup.sh').is_file() else 'installed'
    try:
        trusted=apply_bundle(caller,layout);installed=apply_bundle(directory,'installed')
        if trusted!=installed:raise ValueError('different package')
    except Exception:raise RuntimeUpdateError('package_integrity_failed') from None
    filename='tailscale_'+version+'_amd64.tgz'
    if bundle:
        try:
            source=apply_private(pathlib.Path(bundle))
            raw=runtime_owned_read(source,filename,RUNTIME_ARCHIVE_LIMIT)
            checksum=runtime_checksum(runtime_owned_read(source,filename+'.sha256',4096),filename)
        except RuntimeUpdateError:raise
        except (OSError,ApplyError,ValueError):raise RuntimeUpdateError('unsafe_bundle') from None
    else:
        proxy_url=runtime_proxy(proxy_url);deadline=time.monotonic()+180
        if runtime_latest(proxy_url,deadline)!=version:raise RuntimeUpdateError('invalid_selection')
        base='https://pkgs.tailscale.com/stable/'+filename
        checksum=runtime_checksum(runtime_fetch(base+'.sha256',proxy_url,4096,deadline),filename)
        raw=runtime_fetch(base,proxy_url,RUNTIME_ARCHIVE_LIMIT,deadline)
    payload=runtime_archive(raw,version,checksum)
    with proxy._operation(directory):
        package_transactions=directory/APPLY_DIRECTORY
        if package_transactions.exists() or package_transactions.is_symlink():
            apply_private(package_transactions)
            for previous in package_transactions.iterdir():
                if apply_status(directory,previous.name).get('state') not in ('applied','failed_rolled_back','rejected'):
                    raise RuntimeUpdateError('prior_transaction_requires_manual_review')
        root=apply_private(directory/RUNTIME_DIRECTORY,create=True)
        for previous in root.iterdir():
            previous_status=runtime_status(directory,previous.name)
            if previous_status['state'] not in ('applied','failed_rolled_back','rejected') or previous_status.get('cleanup_warning'):
                raise RuntimeUpdateError('prior_transaction_requires_manual_review')
        if runtime_version(version)<=runtime_version(runtime_probe(directory/'tailscale','version')):raise RuntimeUpdateError('downgrade_or_same_version')
        identifier=uuid.uuid4().hex;transaction=apply_private(root/identifier,create=True)
        journal={'schema':1,'transaction_id':identifier,'boot_id':apply_boot(),'state':'prepared','version':version,
            'phase':'staging','selection':'operator_trusted_bundle' if bundle else 'official_stable',
            'binary_hashes':{name:hashlib.sha256(body).hexdigest() for name,body in payload.items()},
            'worker_hashes':{name:hashlib.sha256(trusted[name]).hexdigest() for name in ('dots-ts','dots_proxy.py')},
            'package_hashes':{name:hashlib.sha256(body).hexdigest() for name,body in installed.items()},'external_ssh':'pending'}
        try:
            apply_journal(transaction,journal)
            stage=apply_private(transaction/'stage',create=True)
            for name,body in payload.items():apply_write(stage/name,body,0o700)
            runtime_verify_pair(stage,version)
            supervisor=apply_private(transaction/'supervisor',create=True)
            for name in ('dots-ts','dots_proxy.py'):apply_write(supervisor/name,trusted[name],0o700)
        except BaseException as error:
            code=error.code if isinstance(error,RuntimeUpdateError) else ('worker_interrupted' if not isinstance(error,Exception) else 'staging_failed')
            try:apply_journal_best_effort(transaction,journal,state='rejected',error=code)
            except BaseException:pass
            if not isinstance(error,Exception):raise
            raise RuntimeUpdateError(code,identifier) from None
    try:
        with open(os.devnull,'ab') as log:
            worker=subprocess.Popen([sys.executable,'-E','-s','-B',str(supervisor/'dots-ts'),'_runtime-worker',str(directory),str(runtime),str(transaction)],
                stdin=subprocess.DEVNULL,stdout=log,stderr=log,close_fds=True,start_new_session=True)
        # Persist worker identity while it waits for the caller's flushed response.
        apply_journal(transaction,journal,worker=apply_identity(worker.pid),phase='awaiting_ack')
    except Exception:
        apply_journal_best_effort(transaction,journal,state='rejected',error='worker_failed');raise RuntimeUpdateError('worker_failed',identifier) from None
    return {'state':'prepared','transaction_id':identifier,'version':version,'external_ssh':'pending'}


def directories():
    directory = pathlib.Path(os.environ.get("DOTS_TS_DIR", str(pathlib.Path(__file__).resolve().parent)))
    if not directory.is_absolute():
        raise ValueError("invalid_directory")
    return directory, pathlib.Path("/tmp/dots-tailscale-{}".format(os.getuid()))


def canonical(path):
    try:
        return os.path.realpath(path)
    except OSError:
        return None


def script_operand(args):
    i = 1
    while i < len(args):
        arg = args[i]
        if arg == "--":
            return args[i + 1] if i + 1 < len(args) else None
        if arg == "--check-hash-based-pycs":
            i += 2
            continue
        if not arg.startswith("-"):
            return arg
        if not re.fullmatch(r"-[uBEIsSObdiPqRvx]+", arg):
            # -W/-X consume their operand, including in combined flags.
            match = re.fullmatch(r"-[uBEIsSObdiPqRvx]*[WX](.*)", arg)
            if not match:
                return None
            if not match.group(1):
                i += 1
        i += 1
    return None


def ssh_config(args):
    if args and args[0].startswith("sshd: "):
        args = args[0][6:].split()
        if "[listener]" not in args:
            return None
        args = args[:args.index("[listener]")]
    config = None
    i = 1
    while i < len(args):
        arg = args[i]
        if not arg.startswith("-") or len(arg) == 1:
            return None
        j = 1
        while j < len(arg):
            option = arg[j]
            if option in "tT":
                return None
            if option in "cEfghopuC":
                value = arg[j + 1:]
                if not value:
                    i += 1
                    if i >= len(args):
                        return None
                    value = args[i]
                if option == "f":
                    if config is not None:
                        return None
                    config = value
                break
            if option not in "Ddeiq46":
                return None
            j += 1
        i += 1
    return config


def process_checks(directory):
    names = ("shim", "tailscaled", "sshd")
    found = set()
    uncertain = False
    try:
        entries = list(pathlib.Path("/proc").iterdir())
    except OSError:
        return {name: "unknown" for name in names}
    expected = {"shim": canonical(str(directory / "shim/shim.py")),
                "tailscaled": canonical(str(directory / "tailscaled")),
                "sshd": canonical(str(directory / "sshd/sshd_config"))}
    def operand_path(entry, operand):
        if not os.path.isabs(operand):
            try:
                operand = os.path.join(os.readlink(str(entry / "cwd")), operand)
            except OSError:
                return None
        return canonical(operand)
    for entry in entries:
        if not entry.name.isdigit() or int(entry.name) == os.getpid():
            continue
        try:
            if entry.stat().st_uid != os.getuid():
                continue
            args = (entry / "cmdline").read_bytes().rstrip(b"\0").decode("utf-8", "surrogateescape").split("\0")
        except FileNotFoundError:
            continue
        except OSError:
            uncertain = True
            continue
        try:
            exe = os.readlink(str(entry / "exe"))
            if exe.endswith(" (deleted)"):
                exe = exe[:-10]
        except FileNotFoundError:
            continue
        except OSError:
            uncertain = True
            continue
        executable = canonical(exe)
        if executable is not None and executable == expected["tailscaled"]:
            found.add("tailscaled")
        interpreter = pathlib.PurePath(exe).name
        if re.fullmatch(r"(?:python(?:3(?:\.\d+)?)?|pypy3(?:\.\d+)?)", interpreter) or (executable is not None and executable == canonical(sys.executable)):
            operand = script_operand(args)
            if operand and operand_path(entry, operand) == expected["shim"]:
                found.add("shim")
        if interpreter == "sshd":
            operand = ssh_config(args)
            if operand and operand_path(entry, operand) == expected["sshd"]:
                found.add("sshd")
    return {name: "running" if name in found else "unknown" if uncertain else "not_running" for name in names}


def run_cli(directory, runtime, args, timeout=MANAGEMENT_TIMEOUT):
    return subprocess.run([str(directory / "tailscale"), "--socket=" + str(runtime / "tailscaled.sock")] + args,
                          input=b"", stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)


def target_parts(target):
    if target.startswith("["):
        match = re.fullmatch(r"\[([^\]]+)\]:(\d+)", target)
    else:
        match = re.fullmatch(r"([^:\s]+):(\d+)", target)
    if (not match or not 1 <= int(match.group(2)) <= 65535
            or not re.fullmatch(r"[A-Za-z0-9_.:%-]+", match.group(1)) or match.group(1).startswith("-")):
        raise ValueError("invalid_target")
    return match.group(1), match.group(2)


def probe_tcp(runtime, host, port):
    # This is the same local userspace DialTCP upgrade used by tailscale nc.
    # HTTP goes only to the local Unix socket: no payload is sent to the peer.
    import time
    deadline = time.monotonic() + MANAGEMENT_TIMEOUT
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(MANAGEMENT_TIMEOUT)
        connection.connect(str(runtime / "tailscaled.sock"))
        request = ("POST /localapi/v0/dial HTTP/1.1\r\nHost: local-tailscaled.sock\r\n"
                   "Connection: upgrade\r\nUpgrade: ts-dial\r\nDial-Network: tcp\r\n"
                   "Dial-Host: {}\r\nDial-Port: {}\r\nContent-Length: 0\r\n\r\n").format(host, port)
        connection.sendall(request.encode("ascii"))
        response = b""
        while b"\r\n\r\n" not in response and len(response) < 16384:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise socket.timeout()
            connection.settimeout(remaining)
            data = connection.recv(1024)
            if not data:
                break
            response += data
        if b"\r\n\r\n" not in response:
            return "invalid_response"
        return "reachable" if re.match(br"HTTP/1\.[01] 101(?: |\r)", response) else "failed"


def installed_file_status(path):
    # Do not follow a leaf symlink: start_all refuses it even if its target is
    # valid. Inspect metadata only; never read authentication/key contents.
    try:
        mode = path.lstat().st_mode
    except FileNotFoundError:
        return "missing"
    except OSError:
        return "unknown"
    if stat.S_ISLNK(mode):
        return "unsafe_symlink"
    return "present" if stat.S_ISREG(mode) else "not_regular"


def directory_context(path):
    """Metadata/access observations only; a positive access check is no write test."""
    result = {"visibility": "unknown", "readable": "unknown", "writable": "unknown",
              "filesystem": "unknown"}
    try:
        mode = path.stat().st_mode
    except FileNotFoundError:
        result["visibility"] = "missing"
        return result
    except PermissionError:
        result["visibility"] = "access_denied"
        return result
    except OSError:
        return result
    if not stat.S_ISDIR(mode):
        result["visibility"] = "not_directory"
        return result
    result["visibility"] = "present"
    try:
        flags = os.statvfs(str(path)).f_flag
        readonly_flag = getattr(os, "ST_RDONLY", None)
        if readonly_flag is not None:
            result["filesystem"] = "read_only" if flags & readonly_flag else "read_write"
    except OSError:
        pass
    try:
        result["readable"] = "allowed" if os.access(str(path), os.R_OK | os.X_OK) else "denied"
        result["writable"] = "allowed" if os.access(str(path), os.W_OK | os.X_OK) else "denied"
    except OSError:
        pass
    if result["filesystem"] == "read_only":
        result["writable"] = "denied"
    return result


def socket_status(path):
    try:
        mode = path.lstat().st_mode
    except FileNotFoundError:
        return "missing"
    except PermissionError:
        return "access_denied"
    except OSError:
        return "unknown"
    if stat.S_ISLNK(mode):
        return "unsafe_symlink"
    return "present" if stat.S_ISSOCK(mode) else "not_socket"


def socket_connection(runtime):
    """Check local connect permission independently of CLI execution failures."""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            connection.settimeout(MANAGEMENT_TIMEOUT)
            connection.connect(str(runtime / "tailscaled.sock"))
        return "connectable"
    except PermissionError:
        return "access_denied"
    except socket.timeout:
        return "timeout"
    except FileNotFoundError:
        return "missing"
    except OSError:
        return "unavailable"


ADVICE = {
    "independent_gui_terminal": "Open the Dots cloud computer's independent GUI terminal and run dots-ts doctor there.",
    "current_context_only": "These results describe only this execution context; an invisible daemon may be running elsewhere.",
    "access_checks_only": "Directory access checks use metadata and access permissions; no write was attempted.",
    "inspect_unknown_checks": "Some checks could not be completed; inspect them from the independent GUI terminal."
}


def doctor(directory, runtime, target=None):
    files = ("installed", "setup.sh", "start.sh", "dots-ts", "dots_proxy.py", "tailscale", "tailscaled", "shim/shim.py",
             "shim/ca.crt", "shim/ca.key", "shim/bundle.crt", "sshd/sshd_config",
             "sshd/ssh_host_ed25519_key", "sshd/authorized_keys")
    checks = {"package": package_report(directory), "files": {name: installed_file_status(directory / name) for name in files},
              "processes": process_checks(directory),
              "state": installed_file_status(directory / "state/tailscaled.state"),
              "socket": socket_status(runtime / "tailscaled.sock"),
              "socket_response": "skipped",
              "backend": "skipped", "authentication": "unknown", "target_tcp": "skipped"}
    context = {"scope": "current_execution_context", "process_scope": "visible_processes_only",
               "access_method": "metadata_and_access_only",
               "installation": directory_context(directory), "runtime": directory_context(runtime)}
    if checks["state"] == "present":
        try:
            if (directory / "state/tailscaled.state").stat().st_size == 0:
                checks["state"] = "empty"
        except OSError:
            checks["state"] = "unknown"
    backend_version = {"version": None, "status": "skipped"}
    connection = socket_connection(runtime) if checks["socket"] == "present" else "skipped"
    if connection not in ("connectable", "skipped"):
        checks["socket_response"] = connection
        checks["backend"] = "unavailable"
        backend_version["status"] = connection if connection in ("timeout", "unavailable") else "unavailable"
    if connection == "connectable" and checks["files"]["tailscale"] == "present":
        try:
            result = run_cli(directory, runtime, ["status", "--json"])
            checks["socket_response"] = "responsive" if result.returncode == 0 else "unavailable"
            if result.returncode:
                checks["backend"] = "unavailable"
                backend_version["status"] = "unavailable"
            else:
                status = json.loads(result.stdout)
                backend_version = {"version": status.get("Version"),
                                   "status": "available" if "Version" in status else "missing"}
                state = status.get("BackendState")
                checks["backend"] = {"Running": "running", "NeedsLogin": "needs_login", "NoState": "no_state",
                                     "Stopped": "stopped", "Starting": "starting", "NeedsMachineAuth": "needs_approval"}.get(state, "unknown")
                checks["authentication"] = {"Running": "authenticated", "NeedsLogin": "needs_login",
                                            "NoState": "no_state", "NeedsMachineAuth": "needs_approval"}.get(state, "unknown")
        except subprocess.TimeoutExpired:
            checks["backend"] = "timeout"
            checks["socket_response"] = "timeout"
            backend_version["status"] = "timeout"
        except OSError:
            checks["backend"] = "unavailable"
            checks["socket_response"] = "unavailable"
            backend_version["status"] = "unavailable"
        except (ValueError, TypeError, AttributeError):
            checks["backend"] = "invalid_response"
            backend_version = {"version": None, "status": "invalid_response"}
    checks["runtime_baseline"] = runtime_baseline_report(directory, package=checks["package"], backend=backend_version)
    if target is not None:
        host, port = target_parts(target)
        try:
            checks["target_tcp"] = probe_tcp(runtime, host, port)
        except socket.timeout:
            checks["target_tcp"] = "timeout"
        except OSError:
            checks["target_tcp"] = "unavailable"
    try:
        import dots_proxy
        proxy = dots_proxy.inspect_config(directory, runtime)
        checks["proxy"] = {}
        for key in ("desired", "running"):
            ports = proxy.get(key)
            checks["proxy"][key] = {name: value for name, value in ports.items()
                                    if name in ("socks_port", "http_port") and (value is None or type(value) is int and 0 <= value <= 65535)} if isinstance(ports, dict) else "unknown"
        for key in ("restart_required", "daemon_running"):
            if type(proxy.get(key)) is bool:
                checks["proxy"][key] = proxy[key]
    except Exception:
        # The optional proxy module also raises its own sanitized config error.
        # A broken/unsupported inspection is unknown, never echoed verbatim.
        checks["proxy"] = {"desired": "unknown", "running": "unknown", "restart_required": None,
                           "inspection": "unavailable"}
    unhealthy = (checks["package"]["integrity"] in ("mismatch", "incomplete") or any(value != "present" for value in checks["files"].values()) or checks["socket"] in ("missing", "access_denied", "unsafe_symlink", "not_socket")
                 or "not_running" in checks["processes"].values()
                 or checks["backend"] in ("needs_login", "no_state", "stopped", "needs_approval", "unavailable", "timeout", "invalid_response")
                 or checks["state"] in ("missing", "empty", "unsafe_symlink", "not_regular")
                 or checks["target_tcp"] in ("failed", "timeout", "unavailable", "invalid_response"))
    context_restricted = any(item["filesystem"] == "read_only" or item["readable"] == "denied"
                             or item["writable"] == "denied" or item["visibility"] != "present"
                             for item in (context["installation"], context["runtime"]))
    context_unknown = any("unknown" in item.values() for item in (context["installation"], context["runtime"]))
    degraded = (checks["package"]["integrity"] == "unknown" or context_restricted or context_unknown or checks["socket"] == "unknown"
                or "unknown" in checks["processes"].values() or checks["backend"] in ("unknown", "starting")
                or checks["state"] == "unknown" or checks["proxy"].get("desired") == "unknown"
                or checks["proxy"].get("restart_required", False))
    overall = "unhealthy" if unhealthy else "degraded" if degraded else "healthy"
    advice = ["current_context_only", "access_checks_only"]
    if (context_restricted or checks["socket"] != "present" or connection not in ("connectable", "skipped")
            or checks["socket_response"] in ("unavailable", "timeout", "access_denied")):
        advice.append("independent_gui_terminal")
    if context_unknown or checks["socket"] == "unknown" or "unknown" in checks["processes"].values():
        advice.append("inspect_unknown_checks")
    skipped = [name for name in ("socket_response", "backend", "target_tcp") if checks[name] == "skipped"]
    return {"checks": checks, "healthy": overall == "healthy", "overall": overall, "target_scope": "tcp_only",
            "context": context, "advice": advice, "skipped_checks": skipped}, int(unhealthy)


# Optional local recovery coordination. These files are operational state, not
# package payload: source updates/rollback must never replace or rewind them.
RECOVERY_DIRECTORY = '.recovery'
RECOVERY_MAX_RECORDS = 256
RECOVERY_STATE_LIMIT = 512 * 1024
RECOVERY_START = b'''#!/usr/bin/env bash
set -euo pipefail
DOTS_TS_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export DOTS_TS_DIR
exec bash "$DOTS_TS_DIR/setup.sh" "${1:-start}"
'''


class RecoveryError(Exception):
    pass


def recovery_default():
    return {'schema': 1, 'enabled': False, 'watchdog_wanted': False,
            'restart_after_external': False, 'max_attempts_24h': 3,
            'cooldown_seconds': 3600, 'timeout_seconds': 60,
            'interval_seconds': 60, 'last_clock': 0,
            'watchdog': None, 'attempts': []}


def recovery_identifier(value):
    return isinstance(value, str) and re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,79}', value) is not None


def recovery_time(value):
    return type(value) is int and 0 <= value <= 9999999999


def recovery_identity_valid(value):
    return (isinstance(value, dict) and set(value) == {'pid', 'ticks', 'uid', 'exe'}
            and type(value['pid']) is int and value['pid'] > 0
            and type(value['uid']) is int and value['uid'] == os.getuid()
            and isinstance(value['ticks'], str) and re.fullmatch(r'[0-9]{1,30}', value['ticks'])
            and isinstance(value['exe'], str) and value['exe'].startswith('/') and len(value['exe']) <= 4096)


def recovery_validate(state):
    default = recovery_default()
    if not isinstance(state, dict) or set(state) != set(default) or type(state['schema']) is not int or state['schema'] != 1:
        raise RecoveryError('invalid_recovery_state')
    if any(type(state[key]) is not bool for key in ('enabled', 'watchdog_wanted', 'restart_after_external')):
        raise RecoveryError('invalid_recovery_state')
    for key, low, high in (('max_attempts_24h', 1, 12), ('cooldown_seconds', 60, 86400),
                           ('timeout_seconds', 10, 120), ('interval_seconds', 15, 300)):
        if type(state[key]) is not int or not low <= state[key] <= high:
            raise RecoveryError('invalid_recovery_state')
    if not recovery_time(state['last_clock']) or not isinstance(state['attempts'], list) or len(state['attempts']) > RECOVERY_MAX_RECORDS:
        raise RecoveryError('invalid_recovery_state')
    seen = set()
    previous_time = -1
    for row in state['attempts']:
        keys = {'id', 'actor', 'reason', 'boot_id', 'created_at', 'finished_at', 'state',
                'exit_code', 'external_confirmation', 'executor', 'child', 'counted', 'reconciled'}
        if (not isinstance(row, dict) or set(row) != keys or not recovery_identifier(row['id'])
                or row['id'] in seen or row['actor'] not in ('watchdog', 'external')
                or row['reason'] not in ('components_missing', 'ssh_only', 'external_outage', 'healthy')
                or not recovery_identifier(row['boot_id']) or not recovery_time(row['created_at'])
                or row['finished_at'] is not None and not recovery_time(row['finished_at'])
                or row['state'] not in ('running', 'local_ready', 'failed', 'unknown', 'not_executed', 'skipped_healthy')
                or row['exit_code'] is not None and (type(row['exit_code']) is not int or not -255 <= row['exit_code'] <= 255)
                or row['external_confirmation'] != 'pending' or type(row['counted']) is not bool
                or type(row['reconciled']) is not bool
                or any(row[key] is not None and not recovery_identity_valid(row[key]) for key in ('executor', 'child'))):
            raise RecoveryError('invalid_recovery_state')
        if row['state'] == 'running' and (row['finished_at'] is not None or not row['counted']):
            raise RecoveryError('invalid_recovery_state')
        if row['state'] != 'running' and row['finished_at'] is None:
            raise RecoveryError('invalid_recovery_state')
        if row['finished_at'] is not None and row['finished_at'] < row['created_at']:
            raise RecoveryError('invalid_recovery_state')
        if (row['created_at'] > state['last_clock'] or row['created_at'] < previous_time
                or row['finished_at'] is not None and row['finished_at'] > state['last_clock']
                or row['counted'] != (row['state'] != 'skipped_healthy')
                or row['state'] == 'running' and row['executor'] is None):
            raise RecoveryError('invalid_recovery_state')
        previous_time = row['created_at']
        seen.add(row['id'])
    worker = state['watchdog']
    if worker is not None and (not isinstance(worker, dict)
            or set(worker) != {'id', 'boot_id', 'identity', 'state', 'code_hash'}
            or not recovery_identifier(worker['id']) or not recovery_identifier(worker['boot_id'])
            or worker['identity'] is not None and not recovery_identity_valid(worker['identity'])
            or worker['state'] not in ('starting', 'running', 'stopped', 'code_changed')
            or not isinstance(worker['code_hash'], str) or re.fullmatch('[0-9a-f]{64}', worker['code_hash']) is None):
        raise RecoveryError('invalid_recovery_state')
    return state


def recovery_file(directory, relative, limit=RECOVERY_STATE_LIMIT, nonempty=True, executable=False):
    path = directory / relative
    for parent in (path.parent,) + tuple(path.parent.parents):
        if parent.is_symlink():
            raise RecoveryError('unsafe_recovery_path')
    info = path.lstat()
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1
            or info.st_mode & 0o077 or nonempty and not info.st_size or info.st_size > limit
            or executable and not info.st_mode & stat.S_IXUSR):
        raise RecoveryError('unsafe_recovery_file')
    return info


def recovery_read(folder):
    recovery_file(folder, 'state.json')
    try:
        return recovery_validate(parse_release_json(bounded_code_read(folder, 'state.json', RECOVERY_STATE_LIMIT)))
    except (UpdateError, ValueError, TypeError):
        raise RecoveryError('invalid_recovery_state') from None


def recovery_write(folder, state):
    recovery_validate(state)
    raw = json.dumps(state, sort_keys=True).encode('ascii')
    if len(raw) > RECOVERY_STATE_LIMIT:
        raise RecoveryError('recovery_ledger_full')
    apply_write(folder / 'state.json', raw)


@contextlib.contextmanager
def recovery_lock(folder, name):
    fd = os.open(str(folder / name), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                or stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink != 1):
            raise RecoveryError('unsafe_recovery_lock')
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RecoveryError('recovery_busy') from None
        yield
    finally:
        os.close(fd)


def recovery_folder(directory):
    apply_private(directory)
    return apply_private(directory / RECOVERY_DIRECTORY)


def recovery_boot():
    boot = apply_boot()
    if not recovery_identifier(boot):
        raise RecoveryError('execution_context_unavailable')
    return boot


def recovery_identity(pid):
    try:
        value = apply_identity(pid)
    except ApplyError:
        raise RecoveryError('process_identity_unknown') from None
    if value is not None and not recovery_identity_valid(value):
        raise RecoveryError('process_identity_unknown')
    return value


def recovery_clock(state):
    now = int(time.time())
    if not recovery_time(now) or now < state['last_clock']:
        raise RecoveryError('clock_rollback_manual_review')
    return now


def recovery_worker_status(worker, boot):
    if worker is None:
        return 'not_started'
    if worker['boot_id'] != boot:
        return 'previous_boot'
    if worker['state'] in ('stopped', 'code_changed'):
        return worker['state']
    if worker['identity'] is None:
        return 'unknown'
    current = recovery_identity(worker['identity']['pid'])
    return 'running' if current == worker['identity'] else 'exited_unexpectedly' if current is None else 'identity_changed'


def recovery_summary(state, boot):
    now = recovery_clock(state)
    counted = [row for row in state['attempts'] if row['counted'] and row['created_at'] > now - 86400]
    pending = any(row['state'] in ('running', 'unknown') for row in state['attempts'])
    worker = recovery_worker_status(state['watchdog'], boot)
    return {'schema': 1, 'enabled': state['enabled'], 'scope': 'current_execution_context',
            'watchdog': {'wanted': state['watchdog_wanted'], 'status': worker,
                         'restart_after_external': state['restart_after_external'],
                         'interval_seconds': state['interval_seconds']},
            'policy': {'budget': 'shared_watchdog_and_external', 'max_attempts_24h': state['max_attempts_24h'],
                       'cooldown_seconds': state['cooldown_seconds'], 'attempts_in_window': len(counted),
                       'timeout_seconds': state['timeout_seconds'], 'retained_records': len(state['attempts']),
                       'max_retained_records': RECOVERY_MAX_RECORDS},
            'manual_review_required': pending, 'external_confirmation': 'pending',
            'last_attempt': recovery_result(state['attempts'][-1]) if state['attempts'] else None}


def recovery_result(row):
    return {key: row[key] for key in ('id', 'actor', 'reason', 'state', 'created_at', 'finished_at',
                                     'exit_code', 'external_confirmation', 'reconciled')}


def recovery_update_fence(directory):
    """Read-only evidence. Call the guard as well when authorizing an update."""
    root = directory / RECOVERY_DIRECTORY
    if not root.exists() and not root.is_symlink():
        return {'state': 'not_configured', 'update_allowed': True}
    try:
        folder = recovery_folder(directory)
        state = recovery_read(folder)
        recovery_clock(state)
        if any(row['state'] in ('running', 'unknown') for row in state['attempts']):
            return {'state': 'manual_review_required', 'update_allowed': False}
        return {'state': 'idle' if state['enabled'] else 'disabled', 'update_allowed': state['enabled']}
    except Exception:
        return {'state': 'unknown', 'update_allowed': False}


@contextlib.contextmanager
def recovery_update_guard(directory):
    root = directory / RECOVERY_DIRECTORY
    if not root.exists() and not root.is_symlink():
        yield
        return
    folder = recovery_folder(directory)
    with recovery_lock(folder, 'run.lock'):
        fence = recovery_update_fence(directory)
        if not fence['update_allowed']:
            raise RecoveryError('recovery_blocks_update')
        yield


def recovery_automatic_fence(directory):
    helper = globals().get('automatic_recovery_fence')
    if callable(helper):
        value = helper(directory)
        if not isinstance(value, dict) or type(value.get('recovery_allowed')) is not bool:
            raise RecoveryError('automatic_update_state_unknown')
        state, allowed = value.get('state'), value['recovery_allowed']
        if state in ('idle', 'not_configured') and allowed:
            return
        if state in ('in_progress', 'manual_review_required') and not allowed:
            raise RecoveryError('automatic_update_blocks_recovery')
        raise RecoveryError('automatic_update_state_unknown')
    else:
        root = directory / '.automatic-updates'
        if root.exists() or root.is_symlink():
            raise RecoveryError('automatic_update_state_unknown')


def recovery_preflight(directory, runtime):
    apply_private(directory)
    recovery_boot()
    if recovery_identity(os.getpid()) is None:
        raise RecoveryError('execution_context_unavailable')
    if not os.path.isfile(sys.executable) or not os.access(sys.executable, os.X_OK):
        raise RecoveryError('execution_context_unavailable')
    for relative in ('shim', 'state', 'sshd'):
        apply_private(directory / relative)
    if runtime.exists() or runtime.is_symlink():
        apply_private(runtime)
    elif runtime.parent.is_symlink() or not os.access(str(runtime.parent), os.W_OK | os.X_OK):
        raise RecoveryError('execution_context_unavailable')
    sock = runtime / 'tailscaled.sock'
    if sock.exists() or sock.is_symlink():
        info = sock.lstat()
        if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1:
            raise RecoveryError('unsafe_daemon_socket')
    for relative in ('installed', 'authenticated', 'state/tailscaled.state', 'shim/ca.crt',
                     'shim/ca.key', 'shim/bundle.crt', 'sshd/sshd_config',
                     'sshd/ssh_host_ed25519_key', 'sshd/authorized_keys'):
        recovery_file(directory, relative, limit=16 * 1024 * 1024, nonempty=relative != 'authenticated')
    for relative in ('start.sh', 'setup.sh', 'dots-ts', 'dots_proxy.py', 'tailscale', 'tailscaled', 'shim/shim.py'):
        recovery_file(directory, relative, limit=96 * 1024 * 1024, executable=True)
    if bounded_code_read(directory, 'start.sh', 4096) != RECOVERY_START:
        raise RecoveryError('unsupported_start_script')
    if package_report(directory)['integrity'] != 'match':
        raise RecoveryError('untrusted_or_mixed_package')
    for relative in ('.runtime-update-block',):
        if (directory / relative).exists() or (directory / relative).is_symlink():
            raise RecoveryError('runtime_update_blocks_recovery')
    recovery_automatic_fence(directory)


def recovery_capture(argv):
    process = None
    try:
        process = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                   stderr=subprocess.DEVNULL, close_fds=True)
        deadline = time.monotonic() + MANAGEMENT_TIMEOUT
        output = bytearray()
        with selectors.DefaultSelector() as selector:
            selector.register(process.stdout, selectors.EVENT_READ)
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0 or not selector.select(remaining):
                    raise RecoveryError('local_probe_unknown')
                chunk = os.read(process.stdout.fileno(), min(4096, 65537 - len(output)))
                if not chunk:
                    break
                output.extend(chunk)
                if len(output) > 65536:
                    raise RecoveryError('local_probe_unknown')
        if process.wait(timeout=max(.001, deadline - time.monotonic())):
            raise RecoveryError('local_probe_unknown')
        return parse_release_json(bytes(output))
    except (OSError, subprocess.SubprocessError, UpdateError):
        raise RecoveryError('local_probe_unknown') from None
    finally:
        if process is not None:
            if process.poll() is None:
                process.kill()
            process.wait()
            process.stdout.close()


def recovery_probe(directory, runtime):
    processes = process_checks(directory)
    sock = socket_status(runtime / 'tailscaled.sock')
    if any(value == 'unknown' for value in processes.values()) or sock not in ('present', 'missing'):
        return {'state': 'unknown', 'backend': 'unknown', 'ssh': 'unknown'}
    backend = 'unavailable'
    if sock == 'present':
        value = recovery_capture([str(directory / 'tailscale'), '--socket=' + str(runtime / 'tailscaled.sock'), 'status', '--json'])
        if not isinstance(value, dict) or not isinstance(value.get('BackendState'), str):
            raise RecoveryError('local_probe_unknown')
        backend = value['BackendState']
        if backend in ('NeedsLogin', 'NeedsMachineAuth', 'NoState'):
            return {'state': 'authentication_required', 'backend': backend, 'ssh': 'unknown'}
        if backend != 'Running':
            return {'state': 'unknown', 'backend': backend, 'ssh': 'unknown'}
    if 'not_running' in processes.values():
        reason = 'ssh_only' if processes.get('sshd') == 'not_running' and all(processes.get(k) == 'running' for k in ('shim', 'tailscaled')) else 'components_missing'
        return {'state': reason, 'backend': backend, 'ssh': 'unavailable'}
    if sock == 'missing':
        return {'state': 'unknown', 'backend': backend, 'ssh': 'unknown'}
    try:
        with socket.create_connection(('127.0.0.1', 22), timeout=2) as connection:
            banner = connection.recv(256)
        if not banner.startswith(b'SSH-2.0-'):
            raise OSError()
    except OSError:
        return {'state': 'unknown', 'backend': backend, 'ssh': 'unavailable'}
    return {'state': 'healthy', 'backend': backend, 'ssh': 'banner_ready'}


def recovery_external(options, now):
    if options.actor == 'external':
        if (type(options.claim_expires_at) is not int or not now < options.claim_expires_at <= now + 120
                or type(options.observation_time) is not int or not 0 <= now - options.observation_time <= 150
                or not options.ssh_failed or not options.ping_failed):
            raise RecoveryError('invalid_or_stale_external_claim')
    elif (options.claim_expires_at is not None or options.observation_time is not None
          or options.ssh_failed or options.ping_failed):
        raise RecoveryError('external_claim_flags_for_watchdog')


def recovery_environment(directory):
    environment = {'PATH': '/usr/local/bin:/usr/bin:/bin', 'HOME': os.environ.get('HOME', '/home/agent'),
                   'DOTS_TS_DIR': str(directory)}
    if 'UPSTREAM_PROXY' in os.environ:
        environment['UPSTREAM_PROXY'] = validate_proxy(os.environ['UPSTREAM_PROXY'])
    for key in ('SHIM_MAX_CONNECTIONS',):
        if key in os.environ:
            environment[key] = os.environ[key]
    return environment


def recovery_run(directory, runtime, options):
    if not recovery_identifier(options.request_id):
        raise RecoveryError('invalid_request_id')
    folder = recovery_folder(directory)
    with recovery_lock(folder, 'run.lock'):
        with recovery_lock(folder, 'control.lock'):
            state = recovery_read(folder)
            now = recovery_clock(state)
            boot = recovery_boot()
            prior = next((row for row in state['attempts'] if row['id'] == options.request_id), None)
            if prior is not None:
                if prior['actor'] != options.actor:
                    raise RecoveryError('request_id_conflict')
                return dict(recovery_result(prior), replayed=True)
            recovery_external(options, now)
            if not state['enabled'] or options.actor == 'watchdog' and not state['watchdog_wanted']:
                raise RecoveryError('recovery_disabled')
            if any(row['state'] in ('running', 'unknown') for row in state['attempts']):
                raise RecoveryError('unknown_result_requires_reconciliation')
            recovery_preflight(directory, runtime)
            local = recovery_probe(directory, runtime)
            if local['state'] == 'authentication_required':
                raise RecoveryError('authentication_requires_manual_review')
            if local['state'] not in ('healthy', 'components_missing', 'ssh_only'):
                raise RecoveryError('local_probe_unknown')
            now = recovery_clock(state)
            recovery_external(options, now)
            counted = [row for row in state['attempts'] if row['counted'] and row['created_at'] > now - 86400]
            if local['state'] != 'healthy':
                if len(counted) >= state['max_attempts_24h']:
                    raise RecoveryError('shared_daily_budget_exhausted')
                if counted and now < counted[-1]['created_at'] + state['cooldown_seconds']:
                    raise RecoveryError('shared_cooldown')
            if local['state'] == 'healthy' and options.actor == 'watchdog':
                return {'state': 'healthy', 'external_confirmation': 'pending', 'counted': False}
            if len(state['attempts']) >= RECOVERY_MAX_RECORDS:
                raise RecoveryError('recovery_ledger_full')
            row = {'id': options.request_id, 'actor': options.actor,
                   'reason': local['state'] if options.actor == 'watchdog' or local['state'] == 'healthy' else 'external_outage',
                   'boot_id': boot, 'created_at': now, 'finished_at': None, 'state': 'running',
                   'exit_code': None, 'external_confirmation': 'pending', 'executor': recovery_identity(os.getpid()),
                   'child': None, 'counted': True, 'reconciled': False}
            state['last_clock'] = now
            state['attempts'].append(row)
            if local['state'] == 'healthy':
                row.update(state='skipped_healthy', finished_at=now, counted=False)
                recovery_write(folder, state)
                return dict(recovery_result(row), local=local)
            # Probe the package lock, then release it: start.sh must take that
            # same lock itself. Holding it across the child would deadlock.
            with recovery_lock(directory, '.operation.lock'):
                pass
            recovery_write(folder, state)
            process = None
            try:
                process = subprocess.Popen(['/bin/bash', str(directory / 'start.sh')],
                                           stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                           stderr=subprocess.DEVNULL, close_fds=True,
                                           start_new_session=True, env=recovery_environment(directory))
                row['child'] = recovery_identity(process.pid)
                recovery_write(folder, state)
            except Exception:
                # A child may already have started before persistence failed.
                # Keep the durable running intent; future IDs must not retry it.
                if process is not None:
                    try:
                        process.kill()
                        process.wait(timeout=5)
                    except Exception:
                        pass
                raise RecoveryError('execution_or_journal_uncertain') from None
        outcome = 'unknown'
        code = None
        try:
            code = process.wait(timeout=state['timeout_seconds'])
            outcome = 'local_ready' if code == 0 and recovery_probe(directory, runtime)['state'] == 'healthy' else 'failed' if code else 'unknown'
        except subprocess.TimeoutExpired:
            # Do not kill the process group: it can contain newly started
            # daemons. The result is unknown even if the launcher is killed.
            try:
                process.kill()
                process.wait(timeout=5)
            except Exception:
                pass
        except Exception:
            outcome = 'unknown'
        try:
            with recovery_lock(folder, 'control.lock'):
                state = recovery_read(folder)
                now = recovery_clock(state)
                row = next(item for item in state['attempts'] if item['id'] == options.request_id)
                row.update(state=outcome, finished_at=now, exit_code=code)
                state['last_clock'] = now
                recovery_write(folder, state)
                result = dict(recovery_result(row), local_result_only=True,
                              external_claim_validation='caller_asserted_structure_and_freshness_only' if options.actor == 'external' else 'not_applicable')
        except Exception:
            raise RecoveryError('execution_or_journal_uncertain') from None
    if options.actor == 'external' and outcome == 'local_ready':
        try:
            with recovery_lock(folder, 'control.lock'):
                state = recovery_read(folder)
                restart = state['enabled'] and state['watchdog_wanted'] and state['restart_after_external']
            if restart:
                result['watchdog_restart'] = recovery_watchdog_start(directory, runtime, explicit=False)['state']
            else:
                result['watchdog_restart'] = 'not_requested_or_stopped'
        except Exception:
            # A secondary watchdog failure cannot erase an already durable
            # startup outcome or turn it into permission for another attempt.
            result['watchdog_restart'] = 'unavailable_manual_review'
    return result


def recovery_configure(directory, runtime, options):
    apply_private(directory)
    root = directory / RECOVERY_DIRECTORY
    created = False
    if not root.exists() and not root.is_symlink():
        root.mkdir(mode=0o700)
        created = True
    folder = recovery_folder(directory)
    with recovery_lock(folder, 'control.lock'):
        if created:
            state = recovery_default()
            # A rejected initial configuration leaves a valid disabled record,
            # rather than an ambiguous directory that can never be configured.
            recovery_write(folder, state)
        else:
            state = recovery_read(folder)
        recovery_clock(state)
        for option, key in (('enabled', 'enabled'), ('max_attempts', 'max_attempts_24h'),
                            ('cooldown_seconds', 'cooldown_seconds'), ('timeout_seconds', 'timeout_seconds'),
                            ('interval_seconds', 'interval_seconds'), ('restart_after_external', 'restart_after_external')):
            value = getattr(options, option, None)
            if value is not None:
                state[key] = value
        if not state['enabled']:
            state['watchdog_wanted'] = False
        recovery_validate(state)
        if state['enabled']:
            recovery_preflight(directory, runtime)
        state['last_clock'] = int(time.time())
        recovery_write(folder, state)
        return recovery_summary(state, recovery_boot())


def recovery_stop(directory):
    folder = recovery_folder(directory)
    with recovery_lock(folder, 'control.lock'):
        state = recovery_read(folder)
        state['enabled'] = False
        state['watchdog_wanted'] = False
        recovery_write(folder, state)
        return {'state': 'disabled', 'inflight_action': 'an_already_started_command_can_finish', 'tailscale_stopped': False}


def recovery_status(directory, runtime):
    root = directory / RECOVERY_DIRECTORY
    if not root.exists() and not root.is_symlink():
        return {'schema': 1, 'state': 'not_configured', 'enabled': False, 'network': 'not_probed', 'external_confirmation': 'pending'}
    state = recovery_read(recovery_folder(directory))
    result = recovery_summary(state, recovery_boot())
    try:
        recovery_preflight(directory, runtime)
        result['network'] = recovery_probe(directory, runtime)
    except RecoveryError as error:
        result['network'] = {'state': 'unknown', 'reason': str(error)}
    except Exception:
        result['network'] = {'state': 'unknown', 'reason': 'recovery_context_or_state_unavailable'}
    return result


def recovery_reconcile(directory, runtime, options):
    if not options.confirm_reviewed or not recovery_identifier(options.request_id):
        raise RecoveryError('explicit_review_required')
    folder = recovery_folder(directory)
    with recovery_lock(folder, 'run.lock'), recovery_lock(folder, 'control.lock'):
        state = recovery_read(folder)
        row = next((item for item in state['attempts'] if item['id'] == options.request_id), None)
        if row is None or row['state'] not in ('running', 'unknown'):
            raise RecoveryError('no_uncertain_attempt')
        if row['boot_id'] == recovery_boot():
            candidates = [row['child']] + ([row['executor']] if row['state'] == 'running' else [])
            for identity in candidates:
                if identity is not None and recovery_identity(identity['pid']) is not None:
                    raise RecoveryError('attempt_process_not_proven_exited')
        if options.outcome == 'local_ready':
            recovery_preflight(directory, runtime)
            if recovery_probe(directory, runtime)['state'] != 'healthy':
                raise RecoveryError('local_readiness_not_confirmed')
        now = recovery_clock(state)
        row.update(state=options.outcome, finished_at=now, reconciled=True)
        state['last_clock'] = now
        recovery_write(folder, state)
        return recovery_result(row)


def recovery_watchdog_start(directory, runtime, explicit=True):
    import uuid
    folder = recovery_folder(directory)
    with recovery_lock(folder, 'control.lock'):
        state = recovery_read(folder)
        if not state['enabled']:
            raise RecoveryError('recovery_disabled')
        if not explicit and (not state['watchdog_wanted'] or not state['restart_after_external']):
            return {'state': 'not_requested_or_stopped'}
        recovery_preflight(directory, runtime)
        boot = recovery_boot()
        status = recovery_worker_status(state['watchdog'], boot)
        if status == 'running':
            if explicit and not state['watchdog_wanted']:
                state['watchdog_wanted'] = True
                recovery_write(folder, state)
            return {'state': 'already_running'}
        if status in ('unknown', 'identity_changed'):
            raise RecoveryError('watchdog_identity_unknown')
        state['watchdog_wanted'] = True
        identifier = uuid.uuid4().hex
        state['watchdog'] = {'id': identifier, 'boot_id': boot, 'identity': None, 'state': 'starting',
                             'code_hash': hashlib.sha256(bounded_code_read(directory, 'dots-ts', 8 * 1024 * 1024)).hexdigest()}
        recovery_write(folder, state)
        process = subprocess.Popen([sys.executable, '-E', '-s', '-B', str(directory / 'dots-ts'),
                                    'recovery', '_watchdog', '--id', identifier],
                                   stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL, close_fds=True, start_new_session=True,
                                   env=recovery_environment(directory))
        identity = recovery_identity(process.pid)
        if identity is None:
            raise RecoveryError('watchdog_start_uncertain')
        state['watchdog'].update(identity=identity, state='running')
        recovery_write(folder, state)
        return {'state': 'started', 'boot_id': boot, 'pid': process.pid}


def recovery_watchdog_stop(directory):
    # The worker checks this durable intention before every run. Do not kill an
    # in-flight startup command or revive an older private watchdog process.
    folder = recovery_folder(directory)
    with recovery_lock(folder, 'control.lock'):
        state = recovery_read(folder)
        state['watchdog_wanted'] = False
        if state['watchdog'] is not None:
            try:
                with recovery_lock(folder, 'watchdog.lock'):
                    # No packaged worker holds the lifetime lock. A pending
                    # process must still check wanted/id before any action.
                    state['watchdog']['state'] = 'stopped'
            except RecoveryError as error:
                if str(error) != 'recovery_busy':
                    raise
        recovery_write(folder, state)
        return {'state': 'stop_requested', 'watchdog_wanted': False,
                'inflight_action': 'can_finish', 'tailscale_stopped': False}


def recovery_watchdog_worker(directory, runtime, identifier):
    import uuid
    folder = recovery_folder(directory)
    own = recovery_identity(os.getpid())
    if own is None:
        raise RecoveryError('process_identity_unknown')
    with recovery_lock(folder, 'watchdog.lock'):
        # Parent holds control.lock while launching and persisting this identity.
        deadline = time.monotonic() + 3
        while True:
            try:
                with recovery_lock(folder, 'control.lock'):
                    state = recovery_read(folder)
                    worker = state['watchdog']
                    if (not worker or worker['id'] != identifier or worker['identity'] != own
                            or worker['boot_id'] != recovery_boot()):
                        raise RecoveryError('watchdog_identity_unknown')
                break
            except RecoveryError as error:
                if str(error) != 'recovery_busy' or time.monotonic() >= deadline:
                    raise
                time.sleep(.05)
        while True:
            state = recovery_read(folder)
            worker = state['watchdog']
            if (not worker or worker['id'] != identifier or worker['identity'] != own
                    or worker['boot_id'] != recovery_boot()):
                raise RecoveryError('watchdog_identity_unknown')
            if not state['enabled'] or not state['watchdog_wanted']:
                with recovery_lock(folder, 'control.lock'):
                    state = recovery_read(folder)
                    # An explicit start may have resumed this same process
                    # while it was entering shutdown. Recheck under the lock.
                    if state['enabled'] and state['watchdog_wanted']:
                        continue
                    if state['watchdog'] and state['watchdog']['id'] == identifier:
                        state['watchdog']['state'] = 'stopped'
                        recovery_write(folder, state)
                return 0
            digest = hashlib.sha256(bounded_code_read(directory, 'dots-ts', 8 * 1024 * 1024)).hexdigest()
            if digest != worker['code_hash']:
                with recovery_lock(folder, 'control.lock'):
                    state = recovery_read(folder)
                    if state['watchdog']['id'] == identifier:
                        state['watchdog']['state'] = 'code_changed'
                        recovery_write(folder, state)
                return 0
            options = argparse.Namespace(actor='watchdog', request_id=uuid.uuid4().hex,
                                         claim_expires_at=None, observation_time=None,
                                         ssh_failed=False, ping_failed=False)
            try:
                recovery_run(directory, runtime, options)
            except (RecoveryError, ApplyError, OSError):
                # Durable unknown results stay fenced; every later tick rereads
                # policy rather than treating a retry time as authorization.
                pass
            # A stopped worker exits within one configured interval. This is a
            # user process, not a platform boot hook or an installed scheduler.
            time.sleep(state['interval_seconds'])


def recovery_main(argv, directory, runtime):
    parser = SafeParser(description='Opt-in local recovery coordination; never installs/authenticates.')
    commands = parser.add_subparsers(dest='recovery_command', required=True)
    configure = commands.add_parser('configure')
    enabled = configure.add_mutually_exclusive_group()
    enabled.add_argument('--enable', dest='enabled', action='store_const', const=True, default=None)
    enabled.add_argument('--disable', dest='enabled', action='store_const', const=False)
    configure.add_argument('--max-attempts', type=int)
    configure.add_argument('--cooldown-seconds', type=int)
    configure.add_argument('--timeout-seconds', type=int)
    configure.add_argument('--interval-seconds', type=int)
    restart = configure.add_mutually_exclusive_group()
    restart.add_argument('--restart-watchdog-after-external', dest='restart_after_external', action='store_const', const=True, default=None)
    restart.add_argument('--no-restart-watchdog-after-external', dest='restart_after_external', action='store_const', const=False)
    run = commands.add_parser('run')
    run.add_argument('--actor', choices=('watchdog', 'external'), required=True)
    run.add_argument('--request-id', required=True)
    run.add_argument('--claim-expires-at', type=int)
    run.add_argument('--observation-time', type=int)
    run.add_argument('--ssh-failed', action='store_true')
    run.add_argument('--ping-failed', action='store_true')
    status = commands.add_parser('status')
    stop = commands.add_parser('stop')
    reconcile = commands.add_parser('reconcile')
    reconcile.add_argument('--request-id', required=True)
    reconcile.add_argument('--outcome', choices=('not_executed', 'failed', 'local_ready'), required=True)
    reconcile.add_argument('--confirm-reviewed', action='store_true')
    watchdog = commands.add_parser('watchdog')
    watchdog_commands = watchdog.add_subparsers(dest='watchdog_command', required=True)
    for name in ('start', 'stop', 'status'):
        watchdog_commands.add_parser(name).add_argument('--json', action='store_true')
    internal = commands.add_parser('_watchdog', help=argparse.SUPPRESS)
    internal.add_argument('--id', required=True)
    for command in (configure, run, status, stop, reconcile):
        command.add_argument('--json', action='store_true')
    try:
        options = parser.parse_args(argv)
        if options.recovery_command == '_watchdog':
            return recovery_watchdog_worker(directory, runtime, options.id)
        if options.recovery_command == 'configure':
            report = recovery_configure(directory, runtime, options)
        elif options.recovery_command == 'run':
            report = recovery_run(directory, runtime, options)
        elif options.recovery_command == 'stop':
            report = recovery_stop(directory)
        elif options.recovery_command == 'reconcile':
            report = recovery_reconcile(directory, runtime, options)
        elif options.recovery_command == 'watchdog' and options.watchdog_command == 'start':
            report = recovery_watchdog_start(directory, runtime)
        elif options.recovery_command == 'watchdog' and options.watchdog_command == 'stop':
            report = recovery_watchdog_stop(directory)
        else:
            report = recovery_status(directory, runtime)
    except RecoveryError as error:
        uncertain = str(error) == 'execution_or_journal_uncertain'
        report = {'state': 'unknown' if uncertain else 'rejected', 'error': str(error), 'external_confirmation': 'pending'}
        if uncertain:
            report['id'] = options.request_id
    except (OSError, ApplyError, UpdateError, ValueError, TypeError, KeyError):
        report = {'state': 'rejected', 'error': 'recovery_context_or_state_unavailable', 'external_confirmation': 'pending'}
    print(json.dumps(report, sort_keys=True))
    return int(report.get('state') in ('rejected', 'unknown', 'failed', 'running') or bool(report.get('error')))

# Automatic updates reuse the manual transaction. No scheduler is installed.
AUTOMATIC_DIRECTORY = '.automatic-updates'
AUTOMATIC_LIMIT = 3
AUTOMATIC_WINDOW = 86400


class AutomaticError(Exception):
    pass


@contextlib.contextmanager
def automatic_store(directory, create=False, runner=False):
    """Private fixed-name control/run locks; status does not create storage."""
    root = folder = lock = None
    try:
        for parent in (pathlib.Path(directory),) + tuple(pathlib.Path(directory).parents):
            if parent.is_symlink(): raise AutomaticError('storage_unavailable')
        root = os.open(str(directory), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        info = os.fstat(root)
        if info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
            raise AutomaticError('storage_unavailable')
        if create:
            try: os.mkdir(AUTOMATIC_DIRECTORY, 0o700, dir_fd=root)
            except FileExistsError: pass
        try:
            folder = os.open(AUTOMATIC_DIRECTORY, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=root)
        except FileNotFoundError:
            yield None
            return
        info = os.fstat(folder)
        if info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
            raise AutomaticError('storage_unavailable')
        name = '.run.lock' if runner else '.control.lock'
        flags = os.O_RDWR | os.O_CREAT if create else os.O_RDONLY
        lock = os.open(name, flags | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600, dir_fd=folder)
        info = os.fstat(lock)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                or stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink != 1):
            raise AutomaticError('storage_unavailable')
        try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError: raise AutomaticError('operation_busy') from None
        yield folder
    except (OSError, NoticeError):
        raise AutomaticError('storage_unavailable') from None
    finally:
        for descriptor in (lock, folder, root):
            if descriptor is not None: os.close(descriptor)


def automatic_defaults():
    return {'schema': 1, 'enabled': False, 'held': False, 'generation': None,
            'interval_hours': 24, 'timezone': 'UTC', 'window_start': 120, 'window_end': 240,
            'pin': None, 'proxy': None, 'provenance_root': None, 'recovery_confirmed_at': None}


def automatic_zone_name(name):
    if name == 'UTC': return
    if (not isinstance(name, str) or len(name) > 128
            or not re.fullmatch(r'[A-Za-z_]+(?:/[A-Za-z0-9_+.-]+){1,5}', name)
            or any(part in ('.', '..') for part in name.split('/'))):
        raise AutomaticError('invalid_timezone')


def automatic_zone(name):
    import datetime
    automatic_zone_name(name)
    if name == 'UTC': return datetime.timezone.utc
    try:
        try: from zoneinfo import ZoneInfo
        except ImportError: from backports.zoneinfo import ZoneInfo
    except ImportError: raise AutomaticError('timezone_unavailable') from None
    try: return ZoneInfo(name)
    except (KeyError, ValueError): raise AutomaticError('invalid_timezone') from None


def automatic_settings(folder):
    return automatic_validate_settings(notice_read(folder, 'settings.json'))


def automatic_validate_settings(value):
    if value is None: return automatic_defaults()
    default = automatic_defaults()
    if not isinstance(value, dict) or set(value) != set(default) or type(value['schema']) is not int or value['schema'] != 1:
        raise AutomaticError('invalid_settings')
    if any(type(value[name]) is not bool for name in ('enabled', 'held')):
        raise AutomaticError('invalid_settings')
    if type(value['interval_hours']) is not int or not 1 <= value['interval_hours'] <= 720:
        raise AutomaticError('invalid_settings')
    automatic_zone_name(value['timezone'])
    if (any(type(value[name]) is not int or not 0 <= value[name] < 1440 for name in ('window_start', 'window_end'))
            or value['window_start'] == value['window_end']):
        raise AutomaticError('invalid_settings')
    for name in ('generation',):
        if value[name] is not None and (not isinstance(value[name], str) or not re.fullmatch('[0-9a-f]{32}', value[name])):
            raise AutomaticError('invalid_settings')
    if value['recovery_confirmed_at'] is not None and (type(value['recovery_confirmed_at']) is not int or value['recovery_confirmed_at'] < 0):
        raise AutomaticError('invalid_settings')
    if value['pin'] is not None:
        automatic_tag(value['pin'])
    try: validate_proxy(value['proxy'])
    except UpdateError: raise AutomaticError('invalid_settings') from None
    path = value['provenance_root']
    if path is not None and (not isinstance(path, str) or len(path) > 4096 or not pathlib.Path(path).is_absolute()):
        raise AutomaticError('invalid_settings')
    if value['enabled'] and (not value['generation'] or path is None or value['recovery_confirmed_at'] is None):
        raise AutomaticError('invalid_settings')
    return value


def automatic_tag(value):
    try:
        if not isinstance(value, str) or not value.startswith('v'): raise ValueError()
        stable_version(value[1:])
    except (UpdateError, ValueError): raise AutomaticError('invalid_pin') from None
    return value


def automatic_empty_state():
    return {'schema': 1, 'last_check_at': None, 'next_check_at': None, 'attempts': [], 'failures': [],
            'last_failed_tag': None, 'inflight': None, 'last_result': None, 'last_notified': None}


def automatic_state(folder, settings):
    value = notice_read(folder, 'state.json')
    if value is None:
        if settings['generation'] is not None: raise AutomaticError('invalid_state')
        return automatic_empty_state()
    if (not isinstance(value, dict) or set(value) != set(automatic_empty_state())
            or type(value['schema']) is not int or value['schema'] != 1):
        raise AutomaticError('invalid_state')
    for name in ('last_check_at', 'next_check_at'):
        if value[name] is not None and (type(value[name]) is not int or value[name] < 0):
            raise AutomaticError('invalid_state')
    for name in ('attempts', 'failures'):
        items = value[name]
        if (not isinstance(items, list) or len(items) > 32
                or any(type(item) is not int or item < 0 for item in items) or items != sorted(items)):
            raise AutomaticError('invalid_state')
    if value['last_failed_tag'] is not None: automatic_tag(value['last_failed_tag'])
    result = value['last_result']
    if result is not None:
        if (not isinstance(result, dict) or set(result) != {'id', 'at', 'status', 'error', 'tag', 'transaction_id', 'external_ssh'}
                or not isinstance(result['id'], str) or not re.fullmatch('[0-9a-f]{32}', result['id'])
                or type(result['at']) is not int or result['at'] < 0
                or not isinstance(result['status'], str) or not re.fullmatch('[a-z_]{1,80}', result['status'])
                or result['external_ssh'] != 'not_verified'):
            raise AutomaticError('invalid_state')
        if result['error'] is not None and (not isinstance(result['error'], str) or not re.fullmatch('[a-z_]{1,100}', result['error'])):
            raise AutomaticError('invalid_state')
        if result['tag'] is not None: automatic_tag(result['tag'])
        if result['transaction_id'] is not None and (not isinstance(result['transaction_id'], str) or not re.fullmatch('[0-9a-f]{32}', result['transaction_id'])):
            raise AutomaticError('invalid_state')
    if value['last_notified'] is not None and (not isinstance(value['last_notified'], str) or not re.fullmatch('[0-9a-f]{32}', value['last_notified'])):
        raise AutomaticError('invalid_state')
    pending = value['inflight']
    if pending is not None:
        if (not isinstance(pending, dict) or set(pending) != {'attempt_id', 'generation', 'phase', 'transaction_id', 'tag', 'at', 'owner'}
                or pending['phase'] not in ('preparing', 'execution_committed', 'submitted', 'manual_review_required')
                or any(not isinstance(pending[name], str) or not re.fullmatch('[0-9a-f]{32}', pending[name]) for name in ('attempt_id', 'generation'))
                or type(pending['at']) is not int or pending['at'] < 0):
            raise AutomaticError('invalid_state')
        automatic_tag(pending['tag'])
        if pending['transaction_id'] is not None and (not isinstance(pending['transaction_id'], str) or not re.fullmatch('[0-9a-f]{32}', pending['transaction_id'])):
            raise AutomaticError('invalid_state')
        owner = pending['owner']
        if (not isinstance(owner, dict) or set(owner) != {'boot_id', 'identity'} or not isinstance(owner['boot_id'], str)
                or not 1 <= len(owner['boot_id']) <= 128 or not isinstance(owner['identity'], dict)
                or set(owner['identity']) != {'pid', 'ticks', 'uid', 'exe'}
                or type(owner['identity']['pid']) is not int or owner['identity']['pid'] <= 0
                or type(owner['identity']['uid']) is not int or owner['identity']['uid'] != os.getuid()
                or not isinstance(owner['identity']['ticks'], str) or not re.fullmatch('[0-9]{1,30}', owner['identity']['ticks'])
                or not isinstance(owner['identity']['exe'], str) or not owner['identity']['exe'].startswith('/') or len(owner['identity']['exe']) > 4096):
            raise AutomaticError('invalid_state')
    return value


def automatic_result(state, now, status, error=None, tag=None, transaction_id=None):
    if error is not None and (not isinstance(error, str) or not re.fullmatch('[a-z_]{1,100}', error)):
        error = 'operation_uncertain'
    state['last_result'] = {'id': os.urandom(16).hex(), 'at': now, 'status': status, 'error': error,
                            'tag': tag, 'transaction_id': transaction_id, 'external_ssh': 'not_verified'}
    return state['last_result']


def automatic_window(settings, now):
    import datetime
    local = datetime.datetime.fromtimestamp(now, automatic_zone(settings['timezone']))
    minute = local.hour * 60 + local.minute
    start, end = settings['window_start'], settings['window_end']
    return start <= minute < end if start < end else minute >= start or minute < end


def automatic_provenance(directory, settings):
    root_check, gh_check = globals().get('provenance_trusted_root'), globals().get('provenance_gh')
    if not callable(root_check) or not callable(gh_check): raise AutomaticError('provenance_unavailable')
    try:
        root_check(settings['provenance_root'], forbidden_directories=(directory,))
        gh_check(forbidden_directories=(directory,))
    except Exception: raise AutomaticError('provenance_unavailable') from None


def automatic_recovery_guard(directory):
    helper = globals().get('recovery_update_guard')
    if not callable(helper): raise AutomaticError('recovery_coordination_unavailable')
    return helper(directory)


def automatic_preflight(directory, runtime, settings):
    import signal
    import dots_proxy as proxy
    if sys.platform != 'linux' or not hasattr(os, 'pidfd_open') or not hasattr(signal, 'pidfd_send_signal'):
        raise AutomaticError('unsupported_environment')
    for path in (directory, runtime):
        context = directory_context(path)
        if (context['visibility'] != 'present' or context['readable'] != 'allowed'
                or context['writable'] != 'allowed' or context['filesystem'] != 'read_write'):
            raise AutomaticError('execution_context_unavailable')
    package = package_report(directory)
    try:
        if package['integrity'] != 'match' or stable_version(package['declared_version']) < (0, 8, 0):
            raise AutomaticError('package_not_supported')
    except UpdateError: raise AutomaticError('package_not_supported') from None
    if any(value != 'running' for value in process_checks(directory).values()):
        raise AutomaticError('local_components_unavailable')
    if socket_status(runtime / 'tailscaled.sock') != 'present' or socket_connection(runtime) != 'connectable':
        raise AutomaticError('local_socket_unavailable')
    try:
        reply = run_cli(directory, runtime, ['status', '--json'])
        if reply.returncode or parse_release_json(reply.stdout).get('BackendState') != 'Running':
            raise AutomaticError('local_backend_unavailable')
        config = proxy.inspect_config(directory, runtime)
        if not config.get('daemon_running') or config.get('restart_required'):
            raise AutomaticError('local_components_unavailable')
        with proxy._operation(directory): pass
    except AutomaticError: raise
    except Exception: raise AutomaticError('local_preflight_failed') from None
    for folder_name, status, terminal in ((APPLY_DIRECTORY, apply_status, ('applied', 'failed_rolled_back', 'rejected')),
                                          (RUNTIME_DIRECTORY, runtime_status, ('applied', 'failed_rolled_back', 'rejected'))):
        folder = directory / folder_name
        if not folder.exists(): continue
        try:
            entries = list(apply_private(folder).iterdir())
            if len(entries) > 256: raise ValueError()
            for entry in entries:
                if not re.fullmatch('[0-9a-f]{32}', entry.name): raise ValueError()
                previous = status(directory, entry.name)
                if previous.get('state') not in terminal or previous.get('cleanup_warning'):
                    raise ValueError()
        except Exception: raise AutomaticError('prior_transaction_requires_manual_review') from None
    automatic_provenance(directory, settings)


def automatic_find_transaction(directory, pending):
    root = directory / APPLY_DIRECTORY
    if not root.exists(): return None
    try:
        entries = list(apply_private(root).iterdir())
        if len(entries) > 256: raise ValueError()
        matches = []
        for entry in entries:
            if not re.fullmatch('[0-9a-f]{32}', entry.name): raise ValueError()
            journal = apply_read_journal(apply_private(entry))
            if journal.get('automatic') == {'attempt_id': pending['attempt_id'], 'generation': pending['generation']}:
                matches.append(entry.name)
        if len(matches) > 1: raise ValueError()
        return matches[0] if matches else None
    except Exception: raise AutomaticError('prior_transaction_requires_manual_review') from None


def automatic_observe_pending(directory, pending):
    identifier = pending['transaction_id'] or automatic_find_transaction(directory, pending)
    if identifier:
        try:
            report = apply_status(directory, identifier)
            if (report.get('automatic') != {'attempt_id': pending['attempt_id'], 'generation': pending['generation']}
                    or report.get('selection') != pending['tag']):
                raise ValueError()
            outcome = report['state']
            if outcome not in ('prepared', 'running', 'applied', 'failed_rolled_back', 'rejected'):
                outcome = 'manual_review_required'
            return outcome, identifier
        except Exception: return 'manual_review_required', identifier
    if pending['phase'] != 'preparing': return 'manual_review_required', None
    try:
        owner = pending['owner']
        if owner['boot_id'] == apply_boot() and apply_identity(owner['identity']['pid']) == owner['identity']:
            return 'preparing', None
    except Exception: pass
    return 'manual_review_required', None


def automatic_reconcile(directory, state, now):
    pending = state['inflight']
    if pending is None: return
    outcome, identifier = automatic_observe_pending(directory, pending)
    if identifier: pending['transaction_id'] = identifier
    if outcome in ('applied', 'failed_rolled_back', 'rejected'):
        automatic_result(state, now, outcome, tag=pending['tag'], transaction_id=identifier)
        if outcome != 'applied':
            state['last_failed_tag'] = pending['tag']
            state['failures'] = (state['failures'] + [now])[-32:]
        state['inflight'] = None
    elif outcome not in ('prepared', 'running', 'preparing'):
        pending['phase'] = 'manual_review_required'
        automatic_result(state, now, 'manual_review_required', tag=pending['tag'], transaction_id=identifier)


def automatic_recovery_fence(directory):
    """Read-only reciprocal fence; a lost acknowledgement never permits recovery."""
    try:
        with automatic_store(directory) as folder:
            if folder is None: return {'state': 'not_configured', 'recovery_allowed': True}
            state = automatic_state(folder, automatic_settings(folder))
            if state['inflight'] is None: return {'state': 'idle', 'recovery_allowed': True}
            outcome, _ = automatic_observe_pending(directory, state['inflight'])
            if outcome in ('applied', 'failed_rolled_back', 'rejected'):
                return {'state': 'idle', 'recovery_allowed': True}
            return {'state': 'manual_review_required' if outcome == 'manual_review_required' else 'in_progress', 'recovery_allowed': False}
    except Exception: return {'state': 'unknown', 'recovery_allowed': False}


def automatic_candidate_guard(directory, tag):
    """Recheck under the updater's operation lock; discovery can become stale."""
    package = package_report(directory)
    try:
        if (package['integrity'] != 'match' or stable_version(tag[1:]) < (0, 8, 0)
                or stable_version(tag[1:]) <= stable_version(package['declared_version'])):
            raise AutomaticError('candidate_not_newer')
    except UpdateError: raise AutomaticError('candidate_not_newer') from None


def automatic_worker_commit(directory, transaction, journal):
    """The same short control lock orders disable/hold against execution commit."""
    fence = journal.get('automatic')
    if fence is None: return
    if (not isinstance(fence, dict) or set(fence) != {'attempt_id', 'generation'}
            or any(not isinstance(value, str) or not re.fullmatch('[0-9a-f]{32}', value) for value in fence.values())):
        raise ApplyError('invalid_automatic_fence')
    try:
        with automatic_recovery_guard(directory):
            with automatic_store(directory, create=True) as folder:
                settings = automatic_settings(folder)
                state = automatic_state(folder, settings)
                pending = state['inflight']
                if (not settings['enabled'] or settings['held'] or settings['generation'] != fence['generation']
                        or pending is None or pending['phase'] not in ('preparing', 'submitted')
                        or any(pending[name] != fence[name] for name in fence)
                        or pending['transaction_id'] not in (None, transaction.name)
                        or journal.get('selection') != pending['tag']
                        or not automatic_window(settings, int(time.time()))
                        or not 0 <= int(time.time()) - pending['at'] <= 300):
                    raise AutomaticError('automatic_cancelled_before_commit')
                automatic_candidate_guard(directory, pending['tag'])
                pending.update(phase='execution_committed', transaction_id=transaction.name)
                notice_write(folder, 'state.json', state)
    except AutomaticError as error: raise ApplyError(str(error)) from None
    except Exception: raise ApplyError('automatic_commit_blocked') from None


def automatic_configure(directory, runtime, command, options):
    with automatic_store(directory, create=True) as folder:
        settings = automatic_settings(folder)
        generation = settings['generation']
        if command in ('disable', 'hold', 'unhold'):
            # Stopping or holding must work during an outage, without preflight.
            if command == 'disable': settings['enabled'] = False
            else: settings['held'] = command == 'hold'
            if settings['generation'] is None:
                notice_write(folder, 'state.json', automatic_empty_state())
            settings['generation'] = os.urandom(16).hex()
            notice_write(folder, 'settings.json', settings)
            return dict(settings, state='disabled' if not settings['enabled'] else 'held' if settings['held'] else 'enabled',
                        committed_transaction_may_finish=True)
        state = automatic_state(folder, settings)
        if command == 'reset-failures':
            if not options.confirm_recovery_terminal: raise AutomaticError('confirmation_required')
            automatic_reconcile(directory, state, int(time.time()))
            if state['inflight'] is not None: raise AutomaticError('manual_review_required')
            state.update(failures=[], last_failed_tag=None, next_check_at=None)
            notice_write(folder, 'state.json', state)
            return {'state': 'failure_hold_cleared', 'attempt_budget_preserved': True}
        for name in ('interval_hours', 'timezone', 'pin', 'proxy', 'provenance_root'):
            value = getattr(options, name, None)
            if value is not None: settings[name] = str(value) if name == 'provenance_root' else value
        if getattr(options, 'unpin', False): settings['pin'] = None
        if getattr(options, 'direct', False): settings['proxy'] = None
        window = getattr(options, 'window', None)
        if window is not None:
            match = re.fullmatch(r'([01][0-9]|2[0-3]):([0-5][0-9])-([01][0-9]|2[0-3]):([0-5][0-9])', window)
            if match is None: raise AutomaticError('invalid_window')
            parts = [int(part) for part in match.groups()]
            settings.update(window_start=parts[0] * 60 + parts[1], window_end=parts[2] * 60 + parts[3])
        if command == 'enable':
            if not options.confirm_recovery_terminal: raise AutomaticError('confirmation_required')
            settings.update(enabled=True, recovery_confirmed_at=int(time.time()))
        settings['generation'] = os.urandom(16).hex()
        automatic_validate_settings(settings)
    automatic_zone(settings['timezone'])
    # Never acquire recovery/run.lock while holding automatic/control.lock.
    if command == 'enable':
        with automatic_recovery_guard(directory): automatic_preflight(directory, runtime, settings)
    with automatic_store(directory, create=True) as folder:
        current = automatic_settings(folder)
        if current['generation'] != generation: raise AutomaticError('configuration_changed')
        state = automatic_state(folder, current)
        notice_write(folder, 'state.json', state)
        notice_write(folder, 'settings.json', settings)
    return dict(settings, state='held' if settings['held'] else 'enabled' if settings['enabled'] else 'disabled')


def automatic_show(directory):
    with automatic_store(directory) as folder:
        settings = automatic_settings(folder)
        state = automatic_state(folder, settings)
        pending = state['inflight']
        observed = automatic_observe_pending(directory, pending)[0] if pending else None
        result_state = ('manual_review_required' if observed == 'manual_review_required' else
                        'in_progress' if observed in ('prepared', 'running', 'preparing') else
                        'disabled' if not settings['enabled'] else 'held' if settings['held'] else 'enabled')
        return dict(settings, **{key: value for key, value in state.items() if key != 'schema'}, state=result_state,
                    observed_transaction_state=observed, execution_environment='not_rechecked',
                    scheduler='external_caller_required', external_ssh='not_verified')


def automatic_tick(directory, runtime):
    now = int(time.time())
    with automatic_store(directory) as folder:
        settings = automatic_settings(folder)
        if not settings['enabled']: return {'state': 'disabled'}
    with automatic_store(directory, create=True, runner=True):
        with automatic_store(directory, create=True) as folder:
            settings = automatic_settings(folder)
            state = automatic_state(folder, settings)
            had_pending = state['inflight'] is not None
            automatic_reconcile(directory, state, now)
            if had_pending: notice_write(folder, 'state.json', state)
            if state['inflight'] is not None:
                return {'state': 'manual_review_required' if state['inflight']['phase'] == 'manual_review_required' else 'in_progress',
                        'transaction_id': state['inflight']['transaction_id']}
            if not settings['enabled']: return {'state': 'disabled'}
            if settings['held']: return {'state': 'held'}
            if not automatic_window(settings, now): return {'state': 'outside_window'}
            times = state['failures'] + state['attempts']
            if (any(value > now for value in times) or settings['recovery_confirmed_at'] > now
                    or state['last_check_at'] is not None and state['last_check_at'] > now):
                raise AutomaticError('clock_moved_backwards')
            attempts = [value for value in state['attempts'] if value > now - AUTOMATIC_WINDOW]
            failures = [value for value in state['failures'] if value > now - AUTOMATIC_WINDOW]
            if len(attempts) >= AUTOMATIC_LIMIT or len(failures) >= AUTOMATIC_LIMIT:
                return {'state': 'budget_exhausted', 'retry_at': min((attempts if len(attempts) >= AUTOMATIC_LIMIT else failures)) + AUTOMATIC_WINDOW}
            if state['next_check_at'] is not None and now < state['next_check_at']:
                return {'state': 'waiting', 'retry_at': state['next_check_at']}
            generation = settings['generation']
        failure_retry_at = 0
        try:
            with automatic_recovery_guard(directory): automatic_preflight(directory, runtime, settings)
            check = update_check(directory, settings['pin'], settings['proxy'])
            if check['status'] == 'check_failed':
                failure_retry_at = validated_retry(check.get('retry', {}), int(time.time())).get('retry_at', 0)
                raise AutomaticError(check['error'] or 'check_failed')
            if check['status'] not in ('current', 'local_newer', 'update_available'):
                raise AutomaticError('package_not_comparable')
            tag = check['release']['tag']
            automatic_tag(tag)
            if stable_version(tag[1:]) < (0, 8, 0): raise AutomaticError('unsigned_legacy_not_automatic')
            with automatic_recovery_guard(directory):
                automatic_preflight(directory, runtime, settings)
                with automatic_store(directory, create=True) as folder:
                    current = automatic_settings(folder)
                    state = automatic_state(folder, current)
                    if not current['enabled'] or current['held'] or current['generation'] != generation:
                        return {'state': 'configuration_changed'}
                    now = int(time.time())
                    state.update(last_check_at=now, next_check_at=now + settings['interval_hours'] * 3600)
                    if check['status'] != 'update_available':
                        result = automatic_result(state, now, check['status'], tag=tag)
                        notice_write(folder, 'state.json', state)
                        return dict(result)
                    if state['last_failed_tag'] == tag:
                        notice_write(folder, 'state.json', state)
                        return {'state': 'failed_version_held', 'tag': tag}
                    identity = apply_identity(os.getpid())
                    if identity is None: raise AutomaticError('process_identity_unknown')
                    fence = {'attempt_id': os.urandom(16).hex(), 'generation': generation}
                    state['inflight'] = dict(fence, phase='preparing', transaction_id=None, tag=tag, at=now,
                                            owner={'boot_id': apply_boot(), 'identity': identity})
                    state['attempts'] = (state['attempts'] + [now])[-32:]
                    notice_write(folder, 'state.json', state)
            # The durable marker fences recovery in the detached gap. Configuration
            # commands can now win against worker commit under the control lock.
            try:
                applied = update_apply(directory, runtime, tag=tag, confirm=True, proxy_url=settings['proxy'],
                                       allow_unsigned_legacy=False, provenance_root=settings['provenance_root'], automatic=fence)
            except ApplyError as error:
                identifier = getattr(error, 'transaction_id', None)
                with automatic_store(directory, create=True) as folder:
                    current = automatic_settings(folder)
                    state = automatic_state(folder, current)
                    if state['inflight'] is None or state['inflight']['attempt_id'] != fence['attempt_id']:
                        raise AutomaticError('manual_review_required')
                    if identifier:
                        state['inflight']['transaction_id'] = identifier
                        automatic_reconcile(directory, state, int(time.time()))
                    else:
                        state['inflight'] = None
                        state['last_failed_tag'] = tag
                        state['failures'] = (state['failures'] + [int(time.time())])[-32:]
                        automatic_result(state, int(time.time()), 'rejected', str(error), tag)
                    notice_write(folder, 'state.json', state)
                    return (dict(state['last_result']) if state['inflight'] is None else
                            {'state': 'manual_review_required' if state['inflight']['phase'] == 'manual_review_required' else 'in_progress',
                             'transaction_id': state['inflight']['transaction_id']})
            with automatic_store(directory, create=True) as folder:
                current = automatic_settings(folder)
                state = automatic_state(folder, current)
                if state['inflight'] is None or state['inflight']['attempt_id'] != fence['attempt_id']:
                    raise AutomaticError('manual_review_required')
                identifier = applied.get('transaction_id')
                if not isinstance(identifier, str) or not re.fullmatch('[0-9a-f]{32}', identifier):
                    raise AutomaticError('manual_review_required')
                state['inflight']['transaction_id'] = identifier
                if state['inflight']['phase'] != 'execution_committed': state['inflight']['phase'] = 'submitted'
                automatic_reconcile(directory, state, int(time.time()))
                notice_write(folder, 'state.json', state)
                return (dict(state['last_result']) if state['inflight'] is None else
                        {'state': 'manual_review_required' if state['inflight']['phase'] == 'manual_review_required' else 'in_progress',
                         'transaction_id': state['inflight']['transaction_id']})
        except Exception as error:
            with automatic_store(directory, create=True) as folder:
                current = automatic_settings(folder)
                state = automatic_state(folder, current)
                if state['inflight'] is not None:
                    state['inflight']['phase'] = 'manual_review_required'
                    automatic_result(state, int(time.time()), 'manual_review_required', 'operation_uncertain',
                                     state['inflight']['tag'], state['inflight']['transaction_id'])
                else:
                    code = str(error) if isinstance(error, (AutomaticError, ApplyError)) else 'preflight_failed'
                    if isinstance(error, UpdateError): code = error.code
                    count = len([value for value in state['failures'] if value > int(time.time()) - AUTOMATIC_WINDOW])
                    state['failures'] = (state['failures'] + [int(time.time())])[-32:]
                    state['next_check_at'] = max(failure_retry_at, int(time.time()) + min(3600, 300 * (2 ** min(count, 3))))
                    automatic_result(state, int(time.time()), 'check_failed', code)
                notice_write(folder, 'state.json', state)
                return dict(state['last_result'])


def automatic_main(argv, directory, runtime):
    parser = SafeParser(description='Explicit opt-in package update runner; no scheduler is installed.')
    commands = parser.add_subparsers(dest='command', required=True)
    for name in ('enable', 'configure', 'disable', 'hold', 'unhold', 'status', 'tick', 'reset-failures', 'notify', 'watch'):
        command = commands.add_parser(name)
        command.add_argument('--json', action='store_true')
        if name in ('enable', 'configure'):
            command.add_argument('--interval-hours', type=int)
            command.add_argument('--timezone')
            command.add_argument('--window')
            pin = command.add_mutually_exclusive_group()
            pin.add_argument('--pin')
            pin.add_argument('--unpin', action='store_true')
            proxy = command.add_mutually_exclusive_group()
            proxy.add_argument('--proxy')
            proxy.add_argument('--direct', action='store_true')
            command.add_argument('--provenance-root', type=pathlib.Path)
        if name in ('enable', 'reset-failures'):
            command.add_argument('--confirm-recovery-terminal', action='store_true')
        if name == 'watch':
            command.add_argument('--seconds', type=int, default=3600)
            command.add_argument('--poll-seconds', type=int, default=60)
    try:
        options = parser.parse_args(argv)
        if options.command == 'status': result = automatic_show(directory)
        elif options.command == 'tick': result = automatic_tick(directory, runtime)
        elif options.command == 'watch':
            if not 1 <= options.seconds <= 86400 or not 30 <= options.poll_seconds <= 3600:
                raise AutomaticError('invalid_watch_interval')
            deadline = time.monotonic() + options.seconds
            while True:
                result = automatic_tick(directory, runtime)
                print(json.dumps(result, sort_keys=True), flush=True)
                if result.get('state', result.get('status')) in ('disabled', 'held', 'manual_review_required'): break
                remaining = deadline - time.monotonic()
                if remaining <= 0: break
                time.sleep(min(options.poll_seconds, remaining))
            return 0
        elif options.command == 'notify':
            result = {'notified': False}
            if sys.stderr.isatty():
                with automatic_store(directory) as folder:
                    settings = automatic_settings(folder)
                    state = automatic_state(folder, settings)
                    last = state['last_result']
                    if folder is not None and last is not None and state['last_notified'] != last['id']:
                        print('dots-ts automatic update: ' + last['status'] + (' (' + last['error'] + ')' if last['error'] else ''), file=sys.stderr)
                        state['last_notified'] = last['id']
                        notice_write(folder, 'state.json', state)
                        result['notified'] = True
        else: result = automatic_configure(directory, runtime, options.command, options)
        print(json.dumps(result, sort_keys=True) if options.json else 'automatic updates: ' + json.dumps(result, sort_keys=True))
        return int(result.get('state') == 'manual_review_required' or result.get('status') in ('check_failed', 'rejected', 'failed_rolled_back', 'manual_review_required'))
    except (AutomaticError, NoticeError, OSError, ValueError) as error:
        code = str(error) if isinstance(error, AutomaticError) else 'storage_or_arguments_unavailable'
        if not re.fullmatch('[a-z_]{1,100}', code): code = 'automatic_unavailable'
        print(json.dumps({'error': code}, sort_keys=True))
        return 1


class SafeParser(argparse.ArgumentParser):
    def error(self, message):
        raise ValueError("invalid_arguments")


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    try:
        if argv and argv[0] == '_runtime-worker':
            if len(argv)!=4:raise ValueError('invalid_arguments')
            return runtime_worker(*(pathlib.Path(value) for value in argv[1:]))
        if argv == ['_runtime-fetch']:
            try:
                request=parse_release_json(sys.stdin.buffer.read(16385))
                if not isinstance(request,dict) or set(request)!={'url','proxy','limit'} or type(request['limit']) is not int or not 1<=request['limit']<=RUNTIME_ARCHIVE_LIMIT:
                    raise RuntimeUpdateError('invalid_metadata')
                data=runtime_network(request['url'],request['proxy'],request['limit'])
                print(json.dumps({'data':base64.b64encode(data).decode('ascii')}))
            except Exception:
                print(json.dumps({'error':'network_failed'}))
            return 0
        if argv and argv[0] == '_update-worker':
            if len(argv) != 4: raise ValueError('invalid_worker_arguments')
            return apply_worker(*(pathlib.Path(value) for value in argv[1:]))
        if argv == ["_fetch-update"]:
            try:
                request = parse_release_json(sys.stdin.buffer.read(16385))
                if (not isinstance(request, dict) or set(request) != {"url", "proxy", "limit"}
                        or type(request["limit"]) is not int or not 1 <= request["limit"] <= 8 * 1024 * 1024):
                    raise UpdateError("invalid_response")
                raw = _network_fetch(request["url"], request["proxy"], request["limit"])
                print(json.dumps({"data": base64.b64encode(raw).decode("ascii")}))
            except UpdateError as error:
                print(json.dumps({"error": error.code, "retry": error.retry}))
            return 0
        if argv and argv[0] == "_verify-package":
            if len(argv) != 4 or argv[2] not in ("source", "installed"):
                raise ValueError("invalid_arguments")
            report = package_report(pathlib.Path(argv[1]), argv[2], pathlib.Path(argv[3]))
            if report["integrity"] != "match":
                print("dots-ts: source bundle " + report["reason"], file=sys.stderr)
                return 1
            return 0
        directory, runtime = directories()
        if argv and argv[0] == 'recovery':
            return recovery_main(argv[1:], directory, runtime)

        if argv[:2] == ["update", "automatic"]:
            return automatic_main(argv[2:], directory, runtime)
        if argv and argv[0] == "cli":
            os.execv(str(directory / "tailscale"), [str(directory / "tailscale"), "--socket=" + str(runtime / "tailscaled.sock")] + argv[1:])
        if argv and argv[0] == "proxy":
            import dots_proxy
            try:
                return dots_proxy.main(argv[1:], directory, runtime)
            except dots_proxy.ProxyError as error:
                # ProxyError messages are fixed explanations owned by the
                # companion module; never append OS exception text or paths.
                print("dots-ts: " + str(error), file=sys.stderr)
                return 1
        parser = SafeParser(description="Local CLI forwarding and read-only diagnostics.")
        commands = parser.add_subparsers(dest="command", required=True)
        runtime_parser=commands.add_parser('runtime',help='separate, manual Tailscale binary updates')
        runtime_commands=runtime_parser.add_subparsers(dest='runtime_command',required=True)
        runtime_check_parser=runtime_commands.add_parser('check')
        runtime_check_parser.add_argument('--version')
        runtime_check_parser.add_argument('--proxy',choices=('platform','direct'),default='platform')
        runtime_check_parser.add_argument('--json',action='store_true')
        runtime_apply_parser=runtime_commands.add_parser('apply')
        runtime_apply_parser.add_argument('--version',required=True)
        runtime_apply_parser.add_argument('--bundle',type=pathlib.Path)
        runtime_apply_parser.add_argument('--confirm-recovery-terminal',action='store_true')
        runtime_apply_parser.add_argument('--proxy',choices=('platform','direct'),default='platform')
        runtime_apply_parser.add_argument('--json',action='store_true')
        runtime_status_parser=runtime_commands.add_parser('status')
        runtime_status_parser.add_argument('--id',required=True)
        runtime_status_parser.add_argument('--json',action='store_true')
        update = commands.add_parser("update", help="check stable releases without changing code or services")
        update_commands = update.add_subparsers(dest="update_command", required=True)
        update_commands.add_parser("automatic", help="explicit opt-in package runner; see update automatic --help")
        check = update_commands.add_parser("check")
        check_selection = check.add_mutually_exclusive_group()
        check_selection.add_argument("--tag")
        check_selection.add_argument("--bundle", type=pathlib.Path)
        check.add_argument("--proxy")
        check.add_argument("--json", action="store_true")
        apply = update_commands.add_parser('apply', help='verified detached manual update; requires independent recovery terminal')
        selection = apply.add_mutually_exclusive_group(required=True)
        selection.add_argument('--tag')
        selection.add_argument('--bundle', type=pathlib.Path)
        apply.add_argument('--confirm-recovery-terminal', action='store_true')
        apply.add_argument('--provenance-root', type=pathlib.Path, help='independent trusted Sigstore root file; required for attested releases')
        apply.add_argument('--allow-unsigned-legacy', action='store_true', help='manual operator-reviewed unsigned targets below 0.8.0 only')
        apply.add_argument('--proxy')
        apply.add_argument('--json', action='store_true')
        migrate = update_commands.add_parser('migrate-baseline', help='explicit source-only adoption after a separately verified runtime upgrade')
        migrate.add_argument('--bundle', type=pathlib.Path, required=True)
        migrate.add_argument('--confirm-recovery-terminal', action='store_true')
        migrate.add_argument('--provenance-root', type=pathlib.Path)
        migrate.add_argument('--allow-unsigned-legacy', action='store_true')
        migrate.add_argument('--json', action='store_true')
        status = update_commands.add_parser('status')
        status.add_argument('--id', required=True)
        status.add_argument('--json', action='store_true')
        notices = update_commands.add_parser("notifications", help="opt-in local cached notices; no scheduler")
        notice_commands = notices.add_subparsers(dest="notice_command", required=True)
        configure = notice_commands.add_parser("configure")
        enabled = configure.add_mutually_exclusive_group()
        enabled.add_argument("--enable", dest="enabled", action="store_const", const=True, default=None)
        enabled.add_argument("--disable", dest="enabled", action="store_const", const=False)
        configure.add_argument("--interval-hours", type=int)
        configure.add_argument("--json", action="store_true")
        show = notice_commands.add_parser("show")
        show.add_argument("--json", action="store_true")
        refresh = notice_commands.add_parser("refresh")
        refresh.add_argument("--proxy")
        refresh.add_argument("--force", action="store_true")
        refresh.add_argument("--json", action="store_true")
        notice_commands.add_parser("notify", help="cache-only; interactive stderr only")
        version = commands.add_parser("version", help="offline package integrity and local Tailscale version")
        version.add_argument("--json", action="store_true")
        diagnostic = commands.add_parser("doctor", help="bounded read-only checks; target probes are TCP only")
        diagnostic.add_argument("--json", action="store_true")
        diagnostic.add_argument("--target")
        options = parser.parse_args(argv)
        if options.command=='runtime':
            prepared=None
            try:
                if options.runtime_command=='check':report=runtime_check(directory,runtime,options.version,options.proxy)
                elif options.runtime_command=='status':report=runtime_status(directory,options.id)
                else:
                    report=runtime_apply(directory,runtime,options.version,options.bundle,options.confirm_recovery_terminal,options.proxy)
                    if report.get('state')=='prepared':prepared=report['transaction_id']
                print(json.dumps(report,sort_keys=True),flush=True)
                if prepared:runtime_ack(directory,prepared)
                return int(bool(report.get('cleanup_warning')) or report.get('state') in ('rejected','failed_rolled_back','manual_recovery_required'))
            except Exception as error:
                if prepared:
                    failure=runtime_error(error,prepared,state='ack_uncertain');failure['action']='inspect_transaction'
                elif options.runtime_command=='status':
                    failure=runtime_error(error,options.id,state='status_unavailable');failure['action']='inspect_transaction'
                else:failure=runtime_error(error)
                print(json.dumps(failure,sort_keys=True),flush=True);return 1
        if options.command == 'update' and options.update_command in ('apply', 'migrate-baseline', 'status'):
            try:
                proof_options = {}
                if getattr(options, 'allow_unsigned_legacy', False):
                    proof_options['allow_unsigned_legacy'] = True
                if getattr(options, 'provenance_root', None) is not None:
                    proof_options['provenance_root'] = options.provenance_root
                if options.update_command == 'status':
                    report = apply_status(directory, options.id)
                elif options.update_command == 'migrate-baseline':
                    report = update_apply(directory, runtime, bundle=options.bundle,
                                          confirm=options.confirm_recovery_terminal, migrate_baseline=True, **proof_options)
                else:
                    report = update_apply(directory, runtime, options.tag, options.bundle, options.confirm_recovery_terminal, options.proxy,
                                          **proof_options)
            except Exception as error:
                report = apply_error_report(error)
            print(json.dumps(report, sort_keys=True))
            return int('error' in report or report.get('state') in ('rejected', 'failed_rolled_back', 'rollback_failed_manual_required', 'interrupted_manual_required'))
        if options.command == "update" and options.update_command == "notifications":
            if options.notice_command == "notify":
                notification_notify(directory)
                return 0
            try:
                if options.notice_command == "configure":
                    report = notification_configure(directory, options.enabled, options.interval_hours)
                elif options.notice_command == "refresh":
                    report = notification_refresh(directory, options.proxy, options.force)
                else:
                    report = notification_show(directory)
            except NoticeError as error:
                report = {"error": error.code}
            if options.json:
                print(json.dumps(report, sort_keys=True))
            else:
                print("update notifications: " + json.dumps(report, sort_keys=True))
            return int("error" in report or report.get("status") == "refresh_failed")
        if options.command == "update":
            if options.bundle is not None and options.proxy is not None:
                raise ValueError('invalid_arguments')
            report = update_check(directory, options.tag, options.proxy, options.bundle)
            if options.json:
                print(json.dumps(report, sort_keys=True))
            else:
                print("update: " + report["status"])
                if report["release"]:
                    print("release: " + report["release"]["tag"] + " (" + report["selection"] + ")")
                if report["error"]:
                    print("error: " + report["error"])
                print("evidence: " + report["evidence"])
                if report.get("trust"):
                    print("trust: " + report["trust"])
                if report.get("retry"):
                    print("retry (advisory): " + json.dumps(report["retry"], sort_keys=True))
                if report.get("warning"):
                    print("warning: " + report["warning"])
            return update_check_exit(report)
        if options.command == "version":
            report = {"package": package_report(directory), "tailscale": tailscale_version(directory)}
            report["runtime_baseline"] = runtime_baseline_report(directory, package=report["package"], cli=report["tailscale"])
            if options.json:
                print(json.dumps(report, sort_keys=True))
            else:
                package = report["package"]
                print("dots-ts package: " + (package["declared_version"] or "unknown"))
                print("source revision: unknown")
                print("source integrity: " + package["integrity"] + " (" + package["reason"] + ")")
                print_runtime_baseline(report["runtime_baseline"])
            return int(report["package"]["integrity"] in ("mismatch", "incomplete"))
        if options.target is not None:
            target_parts(options.target)
        report, code = doctor(directory, runtime, options.target)
        if options.json:
            print(json.dumps(report, sort_keys=True))
        else:
            print("dots-ts doctor: " + report["overall"])
            for category, value in report["checks"].items():
                if category == "runtime_baseline":
                    print_runtime_baseline(value)
                else:
                    print(category + ": " + json.dumps(value, sort_keys=True))
            print("target_scope: tcp_only")
            print("context: " + json.dumps(report["context"], sort_keys=True))
            print("skipped_checks: " + json.dumps(report["skipped_checks"]))
            for advice in report["advice"]:
                print("advice: " + ADVICE[advice])
        return code
    except (OSError, ValueError, ImportError):
        print("dots-ts: invalid_arguments_or_unavailable", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
