            and type(worker.get('pid')) is int and worker['pid']>0 and type(worker.get('uid')) is int
            and worker['uid']==os.getuid() and isinstance(worker.get('ticks'),str) and worker['ticks'].isdigit()
            and isinstance(worker.get('exe'),str))
