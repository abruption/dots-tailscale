                if remaining<=0 or not selector.select(remaining): raise RuntimeUpdateError('binary_probe_failed')
                chunk=os.read(process.stdout.fileno(),4097-len(data))
                if not chunk:break
                data.extend(chunk)
                if len(data)>4096:raise RuntimeUpdateError('binary_probe_failed')
        if process.wait(timeout=max(.001,deadline-time.monotonic())):raise RuntimeUpdateError('binary_probe_failed')
        first=bytes(data).decode('ascii').splitlines()[0];runtime_version(first);return first
    except (OSError,ValueError,IndexError,UnicodeError,subprocess.SubprocessError):raise RuntimeUpdateError('binary_probe_failed') from None
    finally:
        if process is not None:
            if process.poll() is None:process.kill()
            process.wait();process.stdout.close()


