            apply_journal(transaction,journal,phase='candidate_exec_intent',state_compatibility='unknown')
            exec_intent=True
            child=proxy._launch(old['argv'],environment,log_fd)
            apply_journal(transaction,journal,phase='candidate_readiness',candidate_pid=child.pid)
            runtime_ready(directory,runtime,proxy,child,baseline,public,config,hostkey,journal['version'])
            runtime_pair_integrity(directory,journal['binary_hashes'])
            apply_journal(transaction,journal,state='applied',phase='complete',state_compatibility='current_version_only')
            if commit_outcome is not None:commit_outcome['state']='applied'
