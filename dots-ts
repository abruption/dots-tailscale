                apply_journal(transaction,journal,state='failed_rolled_back',phase='complete',error=runtime_error(error)['error'],state_compatibility='not_executed')
                if commit_outcome is not None:commit_outcome['state']='failed_rolled_back'
            except BaseException:
                apply_journal_best_effort(transaction,journal,state='manual_recovery_required',phase='manual_recovery',error='rollback_failed')
