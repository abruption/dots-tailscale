        process=subprocess.Popen([str(path),argument],stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,
            env={'PATH':'/usr/bin:/bin','HOME':'/nonexistent'},close_fds=True)
