            raise RuntimeUpdateError('source_changed')
    apply_journal(transaction,journal,baseline_version=before_version,
        baseline_binary_hashes={name:hashlib.sha256(body).hexdigest() for name,body in backup_bytes.items()})
    with runtime_daemon_log(runtime) as log_fd:
        runtime_fence(directory,journal)
