    return {key:value for key,value in dict(state=state,transaction_id=identifier,version=version,
        phase=phase,error=error,cleanup_warning=warning,external_ssh='pending',
        state_compatibility=compatibility).items() if value is not None}


def runtime_ack(directory, identifier):
    runtime_identifier(identifier);transaction=apply_private(pathlib.Path(directory)/RUNTIME_DIRECTORY/identifier)
    apply_write(transaction/'ack',b'1\n')


def runtime_fence(directory, journal):
    target=pathlib.Path(directory)/RUNTIME_FENCE
    if target.exists() or target.is_symlink():raise RuntimeUpdateError('recovery_fence_present')
    apply_write(target,json.dumps({'schema':1,'transaction_id':journal['transaction_id'],'boot_id':journal['boot_id']}).encode())


def runtime_clear_fence(directory, journal):
    target=pathlib.Path(directory)/RUNTIME_FENCE
    # Acquire the durability descriptor before removing the guard.
    fd=os.open(str(directory),os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
    expected={'schema':1,'transaction_id':journal['transaction_id'],'boot_id':journal['boot_id']}
    removed=False
    try:
        value=parse_release_json(bounded_code_read(directory,RUNTIME_FENCE,4096))
        if value!=expected:raise RuntimeUpdateError('recovery_fence_present')
        target.unlink();removed=True
        os.fsync(fd)
    except BaseException:
        if removed:
            # No replace: never overwrite a different marker, even on cleanup errors.
            try:
                restore=os.open(RUNTIME_FENCE,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,dir_fd=fd)
                with os.fdopen(restore,'wb') as out:
                    out.write(json.dumps(expected).encode());out.flush();os.fsync(out.fileno())
                os.fsync(fd)
            except BaseException:pass
        raise
    finally:os.close(fd)


def runtime_finish_cleanup(directory, transaction, journal):
    # The verified running pair and terminal journal are already committed.
    # Cleanup failure is never permission to stop it or restart older binaries.
    try:runtime_clear_fence(directory,journal)
    except BaseException:
        try:apply_journal_best_effort(transaction,journal,phase='cleanup_review',cleanup_warning='fence_cleanup_failed')
        except BaseException:pass


@contextlib.contextmanager
def runtime_daemon_log(runtime):
    fd=None
