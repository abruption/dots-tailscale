    expected_argv=[str(directory/'tailscaled'),'--tun=userspace-networking','--statedir='+str(directory/'state'),
                   '--socket='+str(runtime/'tailscaled.sock'),'--port=0']+proxy._flags(config['desired'])
    if old['argv'][0]!=expected_argv[0] or sorted(old['argv'][1:])!=sorted(expected_argv[1:]):
        raise RuntimeUpdateError('baseline_unavailable')
